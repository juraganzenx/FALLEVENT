--==================================================
-- AUTO BUY PET
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local CHECK_DELAY = 2
local TWEEN_SPEED = 16

--==================================================
-- TARGET PET + HARGA
--==================================================

local TARGET_PETS = {
    ["Fox"] = 10000000,
    ["Wolf"] = 6000000,
    ["Shadow Dragon"] = 30000000,
    ["Swan"] = 3000000,
}

--==================================================
-- PATH
--==================================================

local WildPetSpawns = workspace
    :WaitForChild("Map")
    :WaitForChild("WildPetSpawns")

--==================================================
-- GET LEAVES
--==================================================

local function GetLeaves()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if not leaderstats then
        return 0
    end

    local leaves = leaderstats:FindFirstChild("Leaves")
    if not leaves then
        return 0
    end

    return leaves.Value
end

--==================================================
-- GET ROOT
--==================================================

local function GetRoot()
    local Character = LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    return Character:WaitForChild("HumanoidRootPart")
end

--==================================================
-- AUTO BUY
--==================================================

while task.wait(CHECK_DELAY) do

    local currentLeaves = GetLeaves()

    for _, pet in ipairs(WildPetSpawns:GetChildren()) do

        local petName = pet:GetAttribute("PetName")
        local petPrice = petName and TARGET_PETS[petName]

        if petPrice and currentLeaves >= petPrice then

            local root = pet:FindFirstChild("RootPart")

            if root then
                local prompt = root:FindFirstChild("BuyPrompt")

                if prompt and prompt:IsA("ProximityPrompt") then

                    local hrp = GetRoot()

                    local distance =
                        (hrp.Position - root.Position).Magnitude

                    local duration = distance / TWEEN_SPEED

                    local tween = TweenService:Create(
                        hrp,
                        TweenInfo.new(
                            duration,
                            Enum.EasingStyle.Linear,
                            Enum.EasingDirection.Out
                        ),
                        {
                            CFrame = root.CFrame
                        }
                    )

                    tween:Play()
                    tween.Completed:Wait()

                    task.wait(0.3)

                    pcall(function()
                        fireproximityprompt(prompt)
                    end)

                    print(
                        "[AUTO BUY] "
                        .. petName
                        .. " | Price="
                        .. tostring(petPrice)
                        .. " | Leaves="
                        .. tostring(GetLeaves())
                    )

                    task.wait(0.5)

                    -- Update Leaves setelah pembelian
                    currentLeaves = GetLeaves()
                end
            end
        end
    end
end
