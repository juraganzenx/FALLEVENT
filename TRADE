--------------------------------------------------
-- FILE PATH
--------------------------------------------------

if not isfolder(SAVE_FOLDER) then
	makefolder(SAVE_FOLDER)
end

local FILE_PATH =
	SAVE_FOLDER .. "/" .. SAVE_FILE

--------------------------------------------------
-- TRADE HISTORY
--------------------------------------------------

local TradeHistory = {}

--------------------------------------------------
-- LOAD JSON
--------------------------------------------------

local function LoadTradeHistory()

	if not isfile(FILE_PATH) then

		print(
			"[JSON] File belum ada."
		)

		TradeHistory = {}

		return

	end

	local Success, Result = pcall(function()

		return HttpService:JSONDecode(
			readfile(FILE_PATH)
		)

	end)

	if Success and typeof(Result) == "table" then

		TradeHistory = Result

		print(
			"[JSON] TradeSchedule berhasil dimuat."
		)

	else

		warn(
			"[JSON] Gagal membaca TradeSchedule.json."
		)

		TradeHistory = {}

	end

end

--------------------------------------------------
-- SAVE JSON
--------------------------------------------------

local function SaveTradeHistory()

	local Success, Error = pcall(function()

		writefile(
			FILE_PATH,
			HttpService:JSONEncode(
				TradeHistory
			)
		)

	end)

	if not Success then

		warn(
			"[JSON] Gagal save:",
			Error
		)

		return false

	end

	return true

end

--------------------------------------------------
-- DATE
--------------------------------------------------

local function GetDate()

	return os.date("%Y-%m-%d")

end

--------------------------------------------------
-- TIME
--------------------------------------------------

local function GetCurrentHour()

	return tonumber(
		os.date("%H")
	)

end

--------------------------------------------------
-- CURRENT SLOT
--------------------------------------------------

local function GetCurrentSlot()

	local Hour =
		GetCurrentHour()

	if SEND_HOURS[Hour] then

		return string.format(
			"%02d",
			Hour
		)

	end

	return nil

end

--------------------------------------------------
-- CHECK SLOT
--------------------------------------------------

local function HasSent(
	Date,
	Slot
)

	if not TradeHistory[Date] then

		return false

	end

	return TradeHistory[Date][Slot] == true

end

--------------------------------------------------
-- MARK SLOT
--------------------------------------------------

local function MarkSent(
	Date,
	Slot
)

	if not TradeHistory[Date] then

		TradeHistory[Date] = {}

	end

	TradeHistory[Date][Slot] = true

	return SaveTradeHistory()

end

--------------------------------------------------
-- CLEAN OLD DATA
--------------------------------------------------

local function CleanOldData()

	local Today =
		GetDate()

	local Changed = false

	for Date in pairs(TradeHistory) do

		if Date ~= Today then

			TradeHistory[Date] = nil

			Changed = true

		end

	end

	if Changed then

		SaveTradeHistory()

	end

end

