	[5] = true,
	[10] = true,
	[15] = true,
	[20] = true
}

--------------------------------------------------
-- TARGET PETS
--------------------------------------------------

local TARGET_PETS = {

	["Fox"] = true,

	["Wolf"] = true,

	["Shadow Dragon"] = true,
	["ShadowDragon"] = true,

	["Swan"] = true,

}

