--------------------------------------------------
-- TRADE HISTORY
--------------------------------------------------

local TradeHistory = {}

--------------------------------------------------
-- LOAD JSON
--------------------------------------------------

local function LoadTradeHistory()

	--------------------------------------------------
	-- FILE HANYA BERDASARKAN LOCALPLAYER.NAME
	--------------------------------------------------

	if not isfile(FILE_PATH) then

		print(
			"[JSON] File belum ada:"
		)

		print(
			FILE_PATH
		)

		TradeHistory = {}

		return

	end

	--------------------------------------------------
	-- READ FILE
	--------------------------------------------------

	local Success, Result =
		pcall(function()

			return HttpService:JSONDecode(
				readfile(FILE_PATH)
			)

		end)

	--------------------------------------------------
	-- INVALID JSON
	--------------------------------------------------

	if not Success then

		warn(
			"[JSON] Gagal membaca file:"
		)

		warn(
			FILE_PATH
		)

		TradeHistory = {}

		return

	end

	--------------------------------------------------
	-- VALID JSON
	--------------------------------------------------

	if typeof(Result) ~= "table" then

		warn(
			"[JSON] Data bukan table."
		)

		TradeHistory = {}

		return

	end

	TradeHistory = Result

	print(
		"[JSON] Loaded:",
		FILE_PATH
	)

end

--------------------------------------------------
-- SAVE JSON
--------------------------------------------------

local function SaveTradeHistory()

	local Success, Error =
		pcall(function()

			writefile(
				FILE_PATH,
				HttpService:JSONEncode(
					TradeHistory
				)
			)

		end)

	if not Success then

		warn(
			"[JSON] Gagal save:",
			Error
		)

		return false

	end

	return true

end

--------------------------------------------------
-- GET DATE
--------------------------------------------------

local function GetDate()

	return os.date(
		"%Y-%m-%d"
	)

end

--------------------------------------------------
-- GET CURRENT HOUR
--------------------------------------------------

local function GetCurrentHour()

	return tonumber(
		os.date("%H")
	)

end

--------------------------------------------------
-- GET CURRENT SLOT
--------------------------------------------------

local function GetCurrentSlot()

	local Hour =
		GetCurrentHour()

	if SEND_HOURS[Hour] then

		return string.format(
			"%02d",
			Hour
		)

	end

	return nil

end

--------------------------------------------------
-- CHECK SLOT
--------------------------------------------------

local function HasSent(
	Date,
	Slot
)

	if not TradeHistory[Date] then

		return false

	end

	return TradeHistory[Date][Slot] == true

end

--------------------------------------------------
-- MARK SLOT SENT
--------------------------------------------------

local function MarkSent(
	Date,
	Slot
)

	if not TradeHistory[Date] then

		TradeHistory[Date] = {}

	end

	TradeHistory[Date][Slot] = true

	return SaveTradeHistory()

end

--------------------------------------------------
-- CLEAN OLD DATA
--------------------------------------------------

local function CleanOldData()

	local Today =
		GetDate()

	local Changed = false

	for Date in pairs(
		TradeHistory
	) do

		if Date ~= Today then

			TradeHistory[Date] = nil

			Changed = true

		end

	end

	if Changed then

		SaveTradeHistory()

	end

end

