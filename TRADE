--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do

	--------------------------------------------------
	-- GET CURRENT DATE
	--------------------------------------------------

	local Date =
		GetDate()

	--------------------------------------------------
	-- GET CURRENT SLOT
	--------------------------------------------------

	local Slot =
		GetCurrentSlot()

	--------------------------------------------------
	-- ACTIVE WINDOW
	--------------------------------------------------

	if Slot then

		--------------------------------------------------
		-- CHECK JSON MILIK AKUN INI
		--------------------------------------------------

		if HasSent(
			Date,
			Slot
		) then

			print(
				"[SCHEDULE]",
				Date,
				"Slot",
				Slot,
				"-> ALREADY SENT"
			)

		else

			print(
				"[SCHEDULE]",
				Date,
				"Slot",
				Slot,
				"-> ACTIVE"
			)

			--------------------------------------------------
			-- TRY SEND
			--------------------------------------------------

			local Success =
				TryTrade()

			--------------------------------------------------
			-- SAVE ONLY IF SUCCESS
			--------------------------------------------------

			if Success then

				local Saved =
					MarkSent(
						Date,
						Slot
					)

				if Saved then

					print(
						"[SCHEDULE] Slot",
						Slot,
						"BERHASIL DISIMPAN."
					)

				else

					warn(
						"[SCHEDULE] Trade berhasil tetapi JSON gagal disimpan!"
					)

				end

			else

				print(
					"[SCHEDULE] Pengiriman gagal."
				)

				print(
					"[SCHEDULE] Akan mencoba lagi."
				)

			end

		end

	else

		--------------------------------------------------
		-- OUTSIDE WINDOW
		--------------------------------------------------

		print(
			"[SCHEDULE] Di luar waktu pengiriman."
		)

	end

	--------------------------------------------------
	-- WAIT
	--------------------------------------------------

	task.wait(
		CHECK_INTERVAL
	)

end
