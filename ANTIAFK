local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local LocalPlayer = Players.LocalPlayer
local Networking = require(ReplicatedStorage.SharedModules.Networking)

--------------------------------------------------
-- SKIP LOADING V2
-- BASED ON ReplicatedFirst.LoadingScreenController
--------------------------------------------------

local RUNNING = true

--==================================================
-- RESTORE CHARACTER
--==================================================

local function RestoreCharacter()
    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if Root and Root:IsA("BasePart") then
        Root.Anchored = false
    end
end

--==================================================
-- RESTORE CAMERA
--==================================================

local function RestoreCamera()
    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    Camera.CameraType = Enum.CameraType.Custom
    Camera.FieldOfView = 70
end

--==================================================
-- RESTORE LIGHTING
--==================================================

local function RestoreLighting()
    local Lighting = game:GetService("Lighting")

    local DepthOfField = Lighting:FindFirstChild("DepthOfField")

    if DepthOfField then
        DepthOfField.Enabled = true
    end

    local Blur = Lighting:FindFirstChild("Blur")

    if Blur then
        pcall(function()
            Blur.Size = 0
        end)
    end
end

--==================================================
-- REMOVE LOADING SCREEN
--==================================================

local function RemoveLoadingScreen()

    -- Workspace direct
    local LoadingScreen = workspace:FindFirstChild("LoadingScreenMenu")

    if LoadingScreen then
        pcall(function()
            LoadingScreen:Destroy()
        end)
    end

    -- Workspace descendants
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object.Name == "LoadingScreenMenu" then
            pcall(function()
                Object:Destroy()
            end)
        end
    end

    -- PlayerGui
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if PlayerGui then
        for _, Object in ipairs(PlayerGui:GetDescendants()) do
            if Object.Name == "LoadingScreenMenu" then

                pcall(function()
                    if Object:IsA("ScreenGui") then
                        Object.Enabled = false
                    end
                end)

                pcall(function()
                    Object:Destroy()
                end)
            end
        end
    end
end

--==================================================
-- DISABLE LOADING STATE
--==================================================

local function DisableLoadingState()

    pcall(function()
        LocalPlayer:SetAttribute("LoadingScreenCovering", false)
    end)

    pcall(function()
        LocalPlayer:SetAttribute("LoadingScreenActive", false)
    end)

    pcall(function()
        LocalPlayer:SetAttribute("LoadingScreenDone", true)
    end)
end

--==================================================
-- FORCE SKIP
--==================================================

local function ForceSkip()

    RemoveLoadingScreen()

    RestoreCamera()
    RestoreLighting()
    RestoreCharacter()

    pcall(function()
        ProximityPromptService.Enabled = true
    end)

    DisableLoadingState()
end

--==================================================
-- CHARACTER ADDED
--==================================================

LocalPlayer.CharacterAdded:Connect(function(Character)

    task.wait()

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if Root then
        Root.Anchored = false
    end

    if RUNNING then
        task.defer(function()
            RestoreCharacter()
        end)
    end
end)

--==================================================
-- INITIAL SKIP
--==================================================

task.spawn(function()

    -- First attempt
    ForceSkip()

    -- Keep checking because LoadingScreenController
    -- may recreate the loading screen
    for i = 1, 40 do

        if not RUNNING then
            break
        end

        ForceSkip()

        task.wait(0.05)
    end

end)

--==================================================
-- RENDER MONITOR
--==================================================

local Connection

Connection = RunService.RenderStepped:Connect(function()

    if not RUNNING then

        if Connection then
            Connection:Disconnect()
            Connection = nil
        end

        return
    end

    -- Restore camera
    RestoreCamera()

    -- Restore character
    RestoreCharacter()

    -- Enable prompts
    pcall(function()
        ProximityPromptService.Enabled = true
    end)

    -- Remove recreated loading screen
    local LoadingScreen = workspace:FindFirstChild("LoadingScreenMenu")

    if LoadingScreen then
        pcall(function()
            LoadingScreen:Destroy()
        end)
    end

end)

--==================================================
-- STOP SKIP LOADING MONITOR
--==================================================

task.spawn(function()

    task.wait(15)

    RUNNING = false

    if Connection then
        Connection:Disconnect()
        Connection = nil
    end

    -- Final restore
    ForceSkip()

    print("[SkipLoading V2] Finished")

end)

print("[SkipLoading V2] Active")

