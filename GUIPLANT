--==================================================
-- GET PLANT NAME
-- HANYA DARI ATTRIBUTE SeedName
--==================================================

local function GetPlantName(Object)

    local SeedName = Object:GetAttribute("SeedName")

    if typeof(SeedName) == "string" and SeedName ~= "" then
        return SeedName
    end

    return nil
end

--==================================================
-- CLEAR LIST
--==================================================

local function ClearList()

    for _, Child in ipairs(Scroll:GetChildren()) do

        if Child:IsA("TextLabel") then
            Child:Destroy()
        end

    end

end

--==================================================
-- CREATE PLANT ROW
--==================================================

local function CreatePlantRow(Name, Count)

    local Row = Instance.new("TextLabel")

    Row.Name = "Plant_" .. Name

    Row.Size = UDim2.new(1, 0, 0, 30)

    Row.BackgroundTransparency = 1

    Row.Text = Name .. " = " .. tostring(Count)

    Row.TextColor3 = Color3.fromRGB(255, 255, 255)

    Row.TextSize = 16

    Row.Font = Enum.Font.Gotham

    Row.TextXAlignment = Enum.TextXAlignment.Left

    Row.Parent = Scroll

end

--==================================================
-- UPDATE PLANTS
--==================================================

local function UpdatePlants()

    local Plot = GetMyPlot()

    if not Plot then

        StatusLabel.Text = "Garden tidak ditemukan"

        TotalLabel.Text = "Total Plant = 0"

        ClearList()

        return
    end

    StatusLabel.Text = "Garden: " .. Plot.Name

    --==============================================
    -- TABLE PLANT
    --==============================================

    local Plants = {}

    local Total = 0

    --==============================================
    -- SCAN DESCENDANTS
    --==============================================

    for _, Object in ipairs(Plot:GetDescendants()) do

        local PlantName = GetPlantName(Object)

        if PlantName then

            Plants[PlantName] = (Plants[PlantName] or 0) + 1

            Total += 1

        end

    end

    --==============================================
    -- CLEAR OLD GUI
    --==============================================

    ClearList()

    --==============================================
    -- TOTAL
    --==============================================

    TotalLabel.Text = "Total Plant = " .. tostring(Total)

    --==============================================
    -- SORT NAME
    --==============================================

    local PlantNames = {}

    for Name in pairs(Plants) do
        table.insert(PlantNames, Name)
    end

    table.sort(PlantNames, function(A, B)

        return A:lower() < B:lower()

    end)

    --==============================================
    -- CREATE ROW
    --==============================================

    for _, Name in ipairs(PlantNames) do

        CreatePlantRow(
            Name,
            Plants[Name]
        )

    end

end

--==================================================
-- INITIAL UPDATE
--==================================================

task.spawn(function()

    while true do

        pcall(function()
            UpdatePlants()
        end)

        task.wait(REFRESH_DELAY)

    end

end)
