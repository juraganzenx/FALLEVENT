--==================================================
-- GET SEED NAME
--==================================================

local function GetPlantName(Object)

    local SeedName = Object:GetAttribute("SeedName")

    if typeof(SeedName) == "string" and SeedName ~= "" then
        return SeedName
    end

    return nil
end

--==================================================
-- CLEAR LIST
--==================================================

local function ClearList()

    for _, Child in ipairs(Scroll:GetChildren()) do

        if Child:IsA("TextLabel") then
            Child:Destroy()
        end

    end

end

--==================================================
-- CREATE ROW
--==================================================

local function CreatePlantRow(Name, Count)

    local Row = Instance.new("TextLabel")

    Row.Name = "Plant_" .. Name

    Row.Size = UDim2.new(1, 0, 0, 22)

    Row.BackgroundTransparency = 1

    Row.Text = Name .. " = " .. tostring(Count)

    Row.TextColor3 = Color3.fromRGB(235, 235, 235)

    Row.TextSize = 12

    Row.Font = Enum.Font.Gotham

    Row.TextXAlignment = Enum.TextXAlignment.Left

    Row.Parent = Scroll

end

--==================================================
-- UPDATE
--==================================================

local function UpdatePlants()

    local Plot = GetMyPlot()

    if not Plot then

        StatusLabel.Text = "Garden tidak ditemukan"

        TotalLabel.Text = "Total: 0"

        ClearList()

        return
    end

    StatusLabel.Text = Plot.Name

    local Plants = {}

    local Total = 0

    --==============================================
    -- SCAN
    --==============================================

    for _, Object in ipairs(Plot:GetDescendants()) do

        local PlantName = GetPlantName(Object)

        if PlantName then

            Plants[PlantName] = (Plants[PlantName] or 0) + 1

            Total += 1

        end

    end

    --==============================================
    -- CLEAR
    --==============================================

    ClearList()

    --==============================================
    -- TOTAL
    --==============================================

    TotalLabel.Text = "Total: " .. tostring(Total)

    --==============================================
    -- SORT
    --==============================================

    local Names = {}

    for Name in pairs(Plants) do
        table.insert(Names, Name)
    end

    table.sort(Names, function(A, B)

        return A:lower() < B:lower()

    end)

    --==============================================
    -- DISPLAY
    --==============================================

    for _, Name in ipairs(Names) do

        CreatePlantRow(
            Name,
            Plants[Name]
        )

    end

end

--==================================================
-- MINIMIZE
--==================================================

local IsMinimized = false

local NormalSize = UDim2.new(0, 220, 0, 300)

local MinimizedSize = UDim2.new(0, 220, 0, 32)

MinimizeButton.MouseButton1Click:Connect(function()

    IsMinimized = not IsMinimized

    if IsMinimized then

        Content.Visible = false

        Main.Size = MinimizedSize

        MinimizeButton.Text = "+"

    else

        Content.Visible = true

        Main.Size = NormalSize

        MinimizeButton.Text = "−"

    end

end)

--==================================================
-- DRAG SYSTEM
--==================================================

local UserInputService = game:GetService("UserInputService")

local Dragging = false

local DragStart

local StartPosition

Header.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true

        DragStart = Input.Position

        StartPosition = Main.Position

        Input.Changed:Connect(function()

            if Input.UserInputState == Enum.UserInputState.End then

                Dragging = false

            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseMovement
        and Input.UserInputType ~= Enum.UserInputType.Touch then

        return
    end

    local Delta = Input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )

end)

--==================================================
-- UPDATE LOOP
--==================================================

task.spawn(function()

    while task.wait(REFRESH_DELAY) do

        pcall(function()
            UpdatePlants()
        end)

    end

end)

