--==================================================
-- GET SEED NAME
--==================================================

local function GetPlantName(Object)

    local SeedName =
        Object:GetAttribute("SeedName")

    if typeof(SeedName) == "string"
        and SeedName ~= "" then

        return SeedName

    end

    return nil
end

--==================================================
-- GET RARITY FROM MANUAL TABLE
--==================================================

local function GetRarity(SeedName)

    return SEED_RARITY[SeedName]
        or "Unknown"

end

--==================================================
-- CLEAR LIST
--==================================================

local function ClearList()

    for _, Child in
        ipairs(Scroll:GetChildren()) do

        if Child:IsA("TextLabel") then
            Child:Destroy()
        end

    end

end

--==================================================
-- CREATE PLANT ROW
--==================================================

local function CreatePlantRow(
    Name,
    Count,
    Rarity,
    Order
)

    local Row =
        Instance.new("TextLabel")

    Row.Name =
        "Plant_" .. Name

    Row.Size =
        UDim2.new(1, 0, 0, 22)

    Row.BackgroundTransparency = 1

    Row.Text =
        Name .. " = " .. tostring(Count)

    --==============================================
    -- COLOR BERDASARKAN RARITY
    --==============================================

    Row.TextColor3 =
        RARITY_COLOR[Rarity]
        or Color3.fromRGB(235, 235, 235)

    Row.TextSize = 12

    Row.Font =
        Enum.Font.Gotham

    Row.TextXAlignment =
        Enum.TextXAlignment.Left

    Row.LayoutOrder = Order

    Row.Parent = Scroll

end

--==================================================
-- UPDATE PLANTS
--==================================================

local function UpdatePlants()

    local Plot = GetMyPlot()

    if not Plot then

        StatusLabel.Text =
            "Garden tidak ditemukan"

        TotalLabel.Text =
            "Total: 0"

        ClearList()

        return
    end

    StatusLabel.Text =
        Plot.Name

    --==============================================
    -- PLANTS
    --==============================================

    local Plants = {}

    local Total = 0

    --==============================================
    -- SCAN GARDEN
    --==============================================

    for _, Object in
        ipairs(Plot:GetDescendants()) do

        -- HANYA SeedName
        local PlantName =
            GetPlantName(Object)

        if PlantName then

            local Rarity =
                GetRarity(PlantName)

            if not Plants[PlantName] then

                Plants[PlantName] = {
                    Count = 0,
                    Rarity = Rarity
                }

            end

            Plants[PlantName].Count += 1

            Total += 1

        end

    end

    --==============================================
    -- CLEAR
    --==============================================

    ClearList()

    --==============================================
    -- TOTAL
    --==============================================

    TotalLabel.Text =
        "Total: " .. tostring(Total)

    --==============================================
    -- BUILD LIST
    --==============================================

    local PlantList = {}

    for Name, Data in
        pairs(Plants) do

        table.insert(
            PlantList,
            {
                Name = Name,
                Count = Data.Count,
                Rarity = Data.Rarity
            }
        )

    end

    --==============================================
    -- SORT RARITY
    --==============================================

    table.sort(
        PlantList,
        function(A, B)

            local OrderA =
                RARITY_ORDER[A.Rarity]
                or 999

            local OrderB =
                RARITY_ORDER[B.Rarity]
                or 999

            if OrderA ~= OrderB then

                return OrderA < OrderB

            end

            -- Kalau rarity sama,
            -- urutkan berdasarkan nama

            return A.Name:lower()
                < B.Name:lower()

        end
    )

    --==============================================
    -- DISPLAY
    --==============================================

    for Index, Data
        in ipairs(PlantList) do

        CreatePlantRow(
            Data.Name,
            Data.Count,
            Data.Rarity,
            Index
        )

    end

end

