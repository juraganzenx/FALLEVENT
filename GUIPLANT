--==================================================

local function GetMyPlot()

    local Gardens =
        workspace:FindFirstChild("Gardens")

    if not Gardens then
        return nil
    end

    for _, Plot in ipairs(Gardens:GetChildren()) do

        if Plot:GetAttribute("Owner")
            == LocalPlayer.Name then

            return Plot

        end

    end

    return nil
end

