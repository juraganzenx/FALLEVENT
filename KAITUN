--==================================================
-- GET RARITY
--==================================================

local function GetRarityFromSeedName(Name)

    if not Name then
        return nil, 0
    end

    Name =
        tostring(Name)

    local Rarity =
        SEED_RARITY[Name]

    if not Rarity then
        return nil, 0
    end

    return Rarity,
        RARITY_ORDER[Rarity] or 0

end


--==================================================
-- GET MY PLOT
--==================================================

local function GetMyPlot()

    --------------------------------------------------
    -- PRIORITY: PlotId
    --------------------------------------------------

    local PlotId =
        LocalPlayer:GetAttribute(
            "PlotId"
        )

    if PlotId ~= nil then

        local Plot =
            Gardens:FindFirstChild(
                "Plot" ..
                tostring(
                    PlotId
                )
            )

        if Plot then
            return Plot
        end

    end


    --------------------------------------------------
    -- FALLBACK: OWNER
    --------------------------------------------------

    for i = 1, 8 do

        local Plot =
            Gardens:FindFirstChild(
                "Plot" .. i
            )

        if Plot
            and Plot:GetAttribute(
                "Owner"
            ) == LocalPlayer.Name then

            return Plot

        end

    end

    return nil

end


--==================================================
-- COUNT VISUAL MODELS
--==================================================

local function CountVisualModels(
    Visual,
    Name
)

    if not Visual then
        return 0
    end

    local Count = 0

    for _, Obj in ipairs(
        Visual:GetChildren()
    ) do

        if Obj.Name == Name then
            Count += 1
        end

    end

    return Count

end


--==================================================
-- GET PLOT LEVEL
--==================================================

local function GetPlotLevel(Plot)

    if not Plot then
        return 0
    end

    local Visual =
        Plot:FindFirstChild(
            "Visual"
        )

    if not Visual then
        return 0
    end


    local FrontCount =
        CountVisualModels(
            Visual,
            "FRONT_BedSection"
        )

    local BedCount =
        CountVisualModels(
            Visual,
            "BedSection"
        )


    if FrontCount < 2 then
        return 0
    end


    if BedCount >= 4 then
        return 3
    end


    if BedCount >= 2 then
        return 2
    end


    if BedCount == 0 then
        return 1
    end


    return 0

end


