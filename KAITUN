--==================================================
-- SORT SEEDS
--==================================================

local function SortSeeds(
    Seeds
)

    table.sort(
        Seeds,
        function(A, B)

            if A.RarityValue
                == B.RarityValue then

                return A.SeedName
                    < B.SeedName

            end


            return A.RarityValue
                > B.RarityValue

        end
    )


    return Seeds

end


--==================================================
-- FIND LOWEST REPLACEABLE PLANT
--
-- GARDEN ATTRIBUTE:
--
-- Plant:GetAttribute("SeedName")
--
-- CONTOH:
--
-- Maple Carrot
-- Maple Apple
-- Maple Corn
--
-- BUKAN:
--
-- MapleCarrotSeed
--==================================================

local function FindLowestReplaceablePlant(
    ValidSeeds
)

    local LowestPlant = nil

    local LowestRarityValue =
        math.huge


    for _, Plant in ipairs(
        GetPlants()
    ) do

        --==================================================
        -- LANGSUNG DARI ATTRIBUTE
        --==================================================

        local PlantSeedName =
            Plant:GetAttribute(
                "SeedName"
            )


        if not PlantSeedName then
            continue
        end


        --==================================================
        -- RARITY
        --==================================================

        local PlantRarity,
            PlantRarityValue =
            GetRarityFromSeedName(
                PlantSeedName
            )


        if not PlantRarity then

            warn(
                "⚠️ Unknown SeedName:",
                PlantSeedName
            )

            continue

        end


        --==================================================
        -- CEK APAKAH ADA SEED YANG
        -- RARITY-NYA LEBIH TINGGI
        --==================================================

        local CanReplace = false


        for _, SeedData in ipairs(
            ValidSeeds
        ) do

            if SeedData.RarityValue
                > PlantRarityValue then

                CanReplace = true

                break

            end

        end


        if not CanReplace then
            continue
        end


        --==================================================
        -- PILIH RARITY TERENDAH
        --==================================================

        if PlantRarityValue
            < LowestRarityValue then

            LowestPlant =
                Plant

            LowestRarityValue =
                PlantRarityValue

        end

    end


    return LowestPlant,
        LowestRarityValue

end


