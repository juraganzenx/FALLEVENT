--==================================================
-- GET NEXT PLANT POSITION
--
-- TIDAK ADA MAX ATTEMPTS
--
-- SELAMA MASIH MEMBUTUHKAN POSISI BARU,
-- AKAN TERUS MENCARI POSISI VALID.
--==================================================

local function GetNextPlantPosition()

    local BottomFace =
        GetBottomFace()


    if not BottomFace then
        return nil
    end


    while true do

        --==================================================
        -- RANDOM ANGLE
        --==================================================

        local Angle =
            math.random()
            * math.pi
            * 2


        --==================================================
        -- RANDOM RADIUS
        --==================================================

        local Radius =
            math.sqrt(
                math.random()
            )
            * RADIUS


        --==================================================
        -- RANDOM HEIGHT
        --==================================================

        local Height =
            math.random()
            * MAX_HEIGHT


        --==================================================
        -- LOCAL POSITION
        --==================================================

        local LocalPos =
            Vector3.new(

                math.cos(
                    Angle
                )
                * Radius,

                Height,

                math.sin(
                    Angle
                )
                * Radius

            )


        --==================================================
        -- WORLD POSITION
        --==================================================

        local WorldPos =
            BottomFace.CFrame:
                PointToWorldSpace(
                    LocalPos
                )


        --==================================================
        -- CHECK DISTANCE
        --==================================================

        local Valid = true


        for _, Position in ipairs(
            UsedPositions
        ) do

            if (
                Position
                - WorldPos
            ).Magnitude
                < MIN_DISTANCE then

                Valid = false

                break

            end

        end


        --==================================================
        -- POSITION VALID
        --==================================================

        if Valid then

            table.insert(
                UsedPositions,
                WorldPos
            )


            return WorldPos

        end

    end

end


--==================================================
-- PLANT SEED
--==================================================

local function PlantSeed(
    SeedData
)

    if not SeedData then
        return false
    end


    local Tool =
        SeedData.Tool


    if not Tool then
        return false
    end


    local Character =
        LocalPlayer.Character


    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    if not Character
        or not Backpack then

        return false

    end


    --==================================================
    -- COUNT TERBARU
    --==================================================

    local CurrentCount =
        tonumber(
            Tool:GetAttribute(
                "Count"
            )
        ) or 0


    if CurrentCount <= 0 then
        return false
    end


    --==================================================
    -- TOOL HARUS VALID
    --==================================================

    if Tool.Parent ~= Character
        and Tool.Parent ~= Backpack then

        return false

    end


    --==================================================
    -- EQUIP
    --==================================================

    if Tool.Parent ~= Character then

        Tool.Parent =
            Character


        task.wait(
            0.1
        )

    end


    --==================================================
    -- SEED TOOL
    --==================================================

    local SeedTool =
        Tool:GetAttribute(
            "SeedTool"
        )


    if not SeedTool then
        return false
    end


    --==================================================
    -- GET NEXT POSITION
    --==================================================

    local PlantPos =
        GetNextPlantPosition()


    if not PlantPos then
        return false
    end


    --==================================================
    -- PLANT
    --==================================================

    local Success =
        pcall(function()

            Networking.Plant
                .PlantSeed
                :Fire(
                    PlantPos,
                    SeedTool,
                    Tool
                )

        end)


    if Success then

        task.wait(
            ACTION_DELAY
        )


        return true

    end


    return false

end


--==================================================
-- SHOVEL PHASE
--
-- FOKUS:
-- KOSONGKAN SLOT YANG DIPERLUKAN
-- SEBELUM PLANT
--==================================================

local function ShovelPhase(
    ValidSeeds
)

    local CurrentPlants =
        CountPlants()


    local TotalSeedCount = 0


    --==================================================
    -- HITUNG TOTAL SEED
    --==================================================

    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        local Count =
            tonumber(
                SeedData.Tool:
                    GetAttribute(
                        "Count"
                    )
            ) or 0


        if Count > 0 then

            TotalSeedCount += Count

        end

    end


    if TotalSeedCount <= 0 then
        return
    end


    --==================================================
    -- SLOT KOSONG
    --==================================================

    local FreeSlots =
        math.max(
            0,
            MAX_PLANTS - CurrentPlants
        )


    --==================================================
    -- BERAPA YANG PERLU DI-SHOVEL
    --==================================================

    local ShovelNeeded =
        math.max(
            0,
            TotalSeedCount - FreeSlots
        )


    print("")
    print(
        "========== SHOVEL PHASE =========="
    )

    print(
        "Plants:",
        CurrentPlants,
        "/",
        MAX_PLANTS
    )

    print(
        "Seeds:",
        TotalSeedCount
    )

    print(
        "Free Slots:",
        FreeSlots
    )

    print(
        "Need Shovel:",
        ShovelNeeded
    )


    --==================================================
    -- TIDAK PERLU SHOVEL
    --==================================================

    if ShovelNeeded <= 0 then

        print(
            "🔨 Tidak perlu shovel."
        )


        UnequipTool()


        return

    end


    --==================================================
    -- SHOVEL LOOP
    --==================================================

    local Shoveled = 0


    while Shoveled < ShovelNeeded do

        --==================================================
        -- CARI PLANT TERENDAH
        --==================================================

        local LowestPlant =
            FindLowestReplaceablePlant(
                ValidSeeds
            )


        if not LowestPlant then

            print(
                "🔨 Tidak ada plant yang bisa diganti."
            )

            break

        end


        local PlantName =
            LowestPlant:GetAttribute(
                "SeedName"
            )


        local BeforeCount =
            CountPlants()


        --==================================================
        -- SHOVEL
        --==================================================

        local Success =
            ShovelPlant(
                LowestPlant
            )


        if not Success then

            warn(
                "❌ Gagal shovel:",
                PlantName
            )

            break

        end


        --==================================================
        -- WAIT PLANT HILANG
        --==================================================

        local Start =
            os.clock()


        while os.clock() - Start < 2 do

            if CountPlants()
                < BeforeCount then

                break

            end


            task.wait(
                0.05
            )

        end


        local AfterCount =
            CountPlants()


        if AfterCount < BeforeCount then

            Shoveled += 1


            print(
                "🔨 Shovel:",
                PlantName,
                "|",
                Shoveled,
                "/",
                ShovelNeeded,
                "|",
                AfterCount,
                "/",
                MAX_PLANTS
            )

        else

            warn(
                "⚠️ Plant tidak berkurang:",
                PlantName
            )

            break

        end


        task.wait(
            ACTION_DELAY
        )

    end


    --==================================================
    -- UNEQUIP
    --==================================================

    UnequipTool()


    task.wait(
        0.15
    )


    print(
        "🔨 SHOVEL PHASE SELESAI"
    )

end


--==================================================
-- PLANT PHASE
--==================================================

local function PlantPhase()

    print("")
    print(
        "========== PLANT PHASE =========="
    )


    --==================================================
    -- REFRESH SEEDS
    --==================================================

    local Seeds =
        GetSeedTools()


    if #Seeds == 0 then

        UnequipTool()

        return

    end


    --==================================================
    -- VALID SEEDS
    --==================================================

    local ValidSeeds = {}


    for _, SeedData in ipairs(
        Seeds
    ) do

        if SeedData.RarityValue > 0 then

            table.insert(
                ValidSeeds,
                SeedData
            )

        else

            warn(
                "⚠️ Rarity tidak ditemukan:",
                SeedData.SeedName
            )

        end

    end


    if #ValidSeeds == 0 then

        UnequipTool()

        return

    end


    --==================================================
    -- HIGHEST RARITY FIRST
    --==================================================

    SortSeeds(
        ValidSeeds
    )


    --==================================================
    -- PLANT SETIAP SEED
    --==================================================

    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        while true do

            --==================================================
            -- COUNT TERBARU
            --==================================================

            local CurrentCount =
                tonumber(
                    SeedData.Tool:
                        GetAttribute(
                            "Count"
                        )
                ) or 0


            --==================================================
            -- SEED HABIS
            --==================================================

            if CurrentCount <= 0 then
                break
            end


            --==================================================
            -- MAX PLANTS
            --==================================================

            local CurrentPlants =
                CountPlants()


            if CurrentPlants
                >= MAX_PLANTS then

                break

            end


            --==================================================
            -- PLANT
            --==================================================

            local Success =
                PlantSeed(
                    SeedData
                )


            if not Success then

                warn(
                    "❌ Gagal plant:",
                    SeedData.SeedName
                )

                break

            end


            print(
                "🌱 Plant:",
                SeedData.SeedName,
                "|",
                CountPlants(),
                "/",
                MAX_PLANTS
            )


            task.wait(
                ACTION_DELAY
            )

        end

    end


    --==================================================
    -- UNEQUIP SETELAH PLANT
    --==================================================

    UnequipTool()


    task.wait(
        0.15
    )


    print(
        "🌱 PLANT PHASE SELESAI"
    )

end


--==================================================
-- SMART PLANT
--
-- 1. SHOVEL DULU
-- 2. UNEQUIP
-- 3. PLANT
-- 4. UNEQUIP
--==================================================

local function SmartPlant()

    --==================================================
    -- GET SEEDS
    --==================================================

    local Seeds =
        GetSeedTools()


    if #Seeds == 0 then
        return
    end


    --==================================================
    -- VALID SEEDS
    --==================================================

    local ValidSeeds = {}


    for _, SeedData in ipairs(
        Seeds
    ) do

        if SeedData.RarityValue > 0 then

            table.insert(
                ValidSeeds,
                SeedData
            )

        end

    end


    if #ValidSeeds == 0 then
        return
    end


    --==================================================
    -- SORT HIGHEST FIRST
    --==================================================

    SortSeeds(
        ValidSeeds
    )


    --==================================================
    -- PHASE 1
    -- SHOVEL
    --==================================================

    ShovelPhase(
        ValidSeeds
    )


    --==================================================
    -- WAIT
    --==================================================

    task.wait(
        0.15
    )


    --==================================================
    -- PHASE 2
    -- PLANT
    --==================================================

    PlantPhase()

end


