--==================================================
-- GET NEXT RANDOM PLANT POSITION
--
-- TIDAK ADA MAX ATTEMPTS
--==================================================

local function GetNextPlantPosition()

    local BottomFace =
        GetBottomFace()

    if not BottomFace then
        return nil
    end


    while true do

        local angle =
            math.random()
            * math.pi
            * 2

        local radius =
            math.sqrt(
                math.random()
            )
            * RADIUS

        local height =
            math.random()
            * MAX_HEIGHT


        local localPos =
            Vector3.new(

                math.cos(angle)
                    * radius,

                height,

                math.sin(angle)
                    * radius

            )


        local worldPos =
            BottomFace.CFrame:
                PointToWorldSpace(
                    localPos
                )


        local Valid = true


        for _, Pos in ipairs(
            UsedPositions
        ) do

            if (
                Pos
                - worldPos
            ).Magnitude
                < MIN_DISTANCE then

                Valid = false

                break

            end

        end


        if Valid then

            table.insert(
                UsedPositions,
                worldPos
            )


            return worldPos

        end

    end

end


