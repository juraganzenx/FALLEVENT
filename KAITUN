local function UseWateringCan()

    local Now =
        os.clock()


    local TimeSinceLastUse =
        Now
        - LastWateringCanUse


    if TimeSinceLastUse <
        SPRINKLER_CONFIG.WATERING_CAN_DELAY then

        return false

    end


    local Plot =
        GetMyPlot()

    if not Plot then
        return false
    end


    local Tool =
        EquipWateringCan()

    if not Tool then

        print(
            "[WATER] Super Watering Can tidak ditemukan."
        )

        return false

    end


    local Position =
        GetFrontBedPosition(
            Plot
        )

    if not Position then

        UnequipTool()

        return false

    end


    local Success =
        pcall(function()

            Networking.WateringCan
                .UseWateringCan
                :Fire(

                    Position
                    + Vector3.new(
                        0,
                        3,
                        0
                    ),

                    SPRINKLER_CONFIG
                        .WATERING_CAN,

