--==================================================
-- GET ALL SEED TOOLS
--==================================================

local function GetSeedTools()

    local Character =
        LocalPlayer.Character


    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    local Result = {}


    if not Backpack then
        return Result
    end


    local function Scan(
        Container
    )

        for _, Tool in ipairs(
            Container:GetChildren()
        ) do

            if not Tool:IsA("Tool") then
                continue
            end


            --==================================================
            -- HARUS PUNYA SEEDTOOL
            --==================================================

            local SeedTool =
                Tool:GetAttribute(
                    "SeedTool"
                )


            if not SeedTool then
                continue
            end


            --==================================================
            -- NAMA SEED
            --
            -- Tool.Name:
            --
            -- Maple Carrot
            -- Maple Dragon Fruit
            --==================================================

            local SeedName =
                Tool.Name


            --==================================================
            -- RARITY
            --==================================================

            local Rarity,
                RarityValue =
                GetRarityFromSeedName(
                    SeedName
                )


            --==================================================
            -- COUNT
            --==================================================

            local Count =
                tonumber(
                    Tool:GetAttribute(
                        "Count"
                    )
                ) or 0


            --==================================================
            -- ONLY COUNT > 0
            --==================================================

            if Count > 0 then

                table.insert(
                    Result,
                    {

                        Tool =
                            Tool,

                        SeedName =
                            SeedName,

                        SeedTool =
                            SeedTool,

                        Count =
                            Count,

                        Rarity =
                            Rarity,

                        RarityValue =
                            RarityValue,

                    }
                )

            end

        end

    end


    --==================================================
    -- BACKPACK
    --==================================================

    Scan(
        Backpack
    )


    --==================================================
    -- CHARACTER
    --==================================================

    if Character then

        Scan(
            Character
        )

    end


    return Result

end


