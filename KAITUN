    local Success =
        pcall(function()

            Networking.Shovel
                .UseShovel
                :Fire(
                    PlantId,
                    "",
                    ShovelType,
                    Shovel
                )

        end)


    if Success then

        task.wait(
            ACTION_DELAY
        )

    end


    return Success

end


