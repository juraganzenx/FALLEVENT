local function CountVisualModels(
    Visual,
    Name
)

    local Count = 0

    for _, Obj in ipairs(
        Visual:GetChildren()
    ) do

        if Obj.Name == Name then

            Count += 1

        end

    end

    return Count

end


--==================================================
