local function GetPlotLevel(
    Plot
)

    if not Plot then
        return 0
    end

    local Visual =
        Plot:FindFirstChild(
            "Visual"
        )

    if not Visual then
        return 0
    end


    local FrontCount =
        CountVisualModels(
            Visual,
            "FRONT_BedSection"
        )


    local BedCount =
        CountVisualModels(
            Visual,
            "BedSection"
        )


    --==================================================
    -- LEVEL 1
    -- 2 FRONT_BedSection
    -- 0 BedSection
    --==================================================

    if FrontCount == 2
        and BedCount == 0 then

        return 1

    end


    --==================================================
    -- LEVEL 2
    -- 2 FRONT_BedSection
    -- 2 BedSection
    --==================================================

    if FrontCount == 2
        and BedCount == 2 then

        return 2

    end


    --==================================================
    -- LEVEL 3
    -- 2 FRONT_BedSection
    -- 4 BedSection
    --==================================================

    if FrontCount == 2
        and BedCount == 4 then

        return 3

    end


    return 0

end


