            table.insert(
                ValidSeeds,
                SeedData
            )

        else

            warn(
                "⚠️ Rarity tidak ditemukan:",
                SeedData.SeedName
            )

        end

    end


    if #ValidSeeds == 0 then

        UnequipTool()

        return

    end


    SortSeeds(
        ValidSeeds
    )


    --==================================================
    -- RESET POSITIONS
    --==================================================

    UsedPositions = {}


    --==================================================
    -- PISAHKAN SPECIAL
    --==================================================

    local SpecialSeeds = {}

    local NormalSeeds = {}


    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        if SPECIAL_SEEDS[
            SeedData.SeedName
        ] then

            table.insert(
                SpecialSeeds,
                SeedData
            )

        else

            table.insert(
                NormalSeeds,
                SeedData
            )

        end

    end


    --==================================================
    -- SPECIAL FIRST
    --==================================================

    PlantSpecialBatch(
        SpecialSeeds
    )


