--==================================================

local function HarvestFruit(Fruit)

    if not Fruit then
        return false
    end

    local CorePartName =
        Fruit:GetAttribute(
            "CorePartName"
        )

    if BLACKLIST[
        CorePartName
    ] then

        return false

    end

    local FruitName =
        GetFruitName(
            Fruit
        )


    if MUTATION_REQUIRED_FRUITS[
        FruitName
    ] then

        local Mutation =
            Fruit:GetAttribute(
                "Mutation"
            )

        if not Mutation then
            return false
        end

    end

    return FireHarvestPrompt(
        Fruit
    )

end


