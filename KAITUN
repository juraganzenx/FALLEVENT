    local FrontCount =
        CountVisualModels(
            Visual,
            "FRONT_BedSection"
        )

    local BedCount =
        CountVisualModels(
            Visual,
            "BedSection"
        )


    if FrontCount == 2
        and BedCount == 0 then

        return 1

    end


    if FrontCount == 2
        and BedCount == 2 then

        return 2

    end


    if FrontCount == 2
