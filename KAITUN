-- AUTO HARVEST
--==================================================

local function AutoHarvest()

    local Plot =
        GetMyPlot()

    if not Plot then
        return
    end

    local Plants =
        Plot:FindFirstChild(
            "Plants"
        )

    if not Plants then
        return
    end


    local PlantList = {}


    for _, Plant in ipairs(
        Plants:GetChildren()
    ) do

        table.insert(
            PlantList,
            Plant
        )

    end


    --------------------------------------------------
    -- PLANT RARITY TERTINGGI -> TERENDAH
    --------------------------------------------------

    table.sort(
        PlantList,
        function(A, B)

            local AName =
                A:GetAttribute(
                    "SeedName"
                )

            local BName =
                B:GetAttribute(
                    "SeedName"
                )


            local _,
                ARarity =
                GetRarityFromSeedName(
                    AName
                )


            local _,
                BRarity =
                GetRarityFromSeedName(
                    BName
                )


            if ARarity ==
                BRarity then

                return tostring(
                    AName
                ) <
                tostring(
                    BName
                )

            end


            return ARarity >
                BRarity

        end
    )


    --------------------------------------------------
    -- HARVEST HIGH RARITY FIRST
    --------------------------------------------------

    for _, Plant in ipairs(
        PlantList
    ) do

        HarvestPlant(
            Plant
        )

    end

end


