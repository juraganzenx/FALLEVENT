--==================================================

local function TryExpand()

    local Plot =
        GetMyPlot()

    if not Plot then
        return
    end


    local Level =
        GetPlotLevel(
            Plot
        )


    if Level <= 0 then

        print(
            "[AUTO EXPAND] Level belum siap."
        )

        return

    end


    local Leaves =
        GetLeaves()

    if Leaves == nil then
        return
    end


    local CurrentMaxPlants =
        PLANT_LIMIT_BY_LEVEL[
            Level
        ] or 200


    print("")
    print(
        "========== AUTO EXPAND =========="
    )

    print(
        "Plot       :",
        Plot.Name
    )

    print(
        "Level      :",
        Level
    )

    print(
        "Leaves     :",
        FormatNumber(
            Leaves
        )
    )

    print(
        "Max Plants :",
        CurrentMaxPlants
    )


    if Level >= MAX_LEVEL then

        print(
            "[AUTO EXPAND] MAX LEVEL:",
            MAX_LEVEL
        )

        return

    end


    local NextLevel =
        Level + 1


    local RequiredLeaves =
        LEVEL_REQUIREMENT[
            NextLevel
        ]


    if not RequiredLeaves then
        return
    end


    print(
        "Next Level :",
        NextLevel
    )

    print(
        "Required   :",
        FormatNumber(
            RequiredLeaves
        )
    )


    if Leaves <
        RequiredLeaves then

        print(
            "[AUTO EXPAND] Leaves belum cukup."
        )

        print(
            "[AUTO EXPAND] Kurang:",
            FormatNumber(
                RequiredLeaves - Leaves
            )
        )

        return

    end


    print(
        "[AUTO EXPAND] Requirement terpenuhi!"
    )

    print(
        "[AUTO EXPAND] Expand:",
        Level,
        "->",
        NextLevel
    )


    local Success,
        Result =
        pcall(function()

            return Networking.Actions
                .ExpandGarden
                :Fire()

        end)


    if not Success then

        warn(
            "[AUTO EXPAND] Error:",
            Result
        )

        return

    end


    print(
        "[AUTO EXPAND] Request berhasil."
    )


    task.wait(
        2
    )


    local NewPlot =
        GetMyPlot()


    local NewLevel =
        GetPlotLevel(
            NewPlot
        )


    local NewMaxPlants =
        PLANT_LIMIT_BY_LEVEL[
            NewLevel
        ]


    print(
        "[AUTO EXPAND] Level sekarang:",
        NewLevel
    )

    print(
        "[AUTO EXPAND] Max Plants sekarang:",
        NewMaxPlants
            or "BELUM TERBACA"
    )

end


