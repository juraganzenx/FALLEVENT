--==================================================
-- PLANT SEED
--==================================================

local function PlantSeed(
    SeedData
)

    if not SeedData then
        return false
    end


    local Tool =
        SeedData.Tool

    if not Tool then
        return false
    end


    local Character =
        LocalPlayer.Character

    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    if not Character
        or not Backpack then

        return false

    end


    local CurrentCount =
        tonumber(
            Tool:GetAttribute(
                "Count"
            )
        ) or 0


    if CurrentCount <= 0 then
        return false
    end


    if Tool.Parent ~= Character
        and Tool.Parent ~= Backpack then

        return false

    end


    if Tool.Parent ~= Character then

        Tool.Parent =
            Character

        task.wait(0.1)

    end


    local SeedTool =
        Tool:GetAttribute(
            "SeedTool"
        )

    if not SeedTool then
        return false
    end


    local BottomFace =
        GetBottomFace()

    if not BottomFace then
        return false
    end


    local Margin = 0.5


    local X =
        (math.random() - 0.5)
        * (
            BottomFace.Size.X
            - Margin * 2
        )


    local Z =
        (math.random() - 0.5)
        * (
            BottomFace.Size.Z
            - Margin * 2
        )


    local PlantPos =
        BottomFace.CFrame:
            PointToWorldSpace(
                Vector3.new(
                    X,
                    0,
                    Z
                )
            )


    local Success =
        pcall(function()

            Networking.Plant
                .PlantSeed
                :Fire(
                    PlantPos,
                    SeedTool,
                    Tool
                )

        end)


    if Success then

        task.wait(
            ACTION_DELAY
        )

        return true

    end


    return false

end


--==================================================
-- SHOVEL PHASE
--==================================================

local function ShovelPhase(
    ValidSeeds
)

    local CurrentPlants =
        CountPlants()


    local TotalSeedCount = 0


    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        local Count =
            tonumber(
                SeedData.Tool:
                    GetAttribute(
                        "Count"
                    )
            ) or 0


        if Count > 0 then

            TotalSeedCount += Count

        end

    end


    if TotalSeedCount <= 0 then
        return
    end


    --==================================================
    -- DYNAMIC MAX PLANTS
    --==================================================

    local MAX_PLANTS =
        GetMaxPlants()


    local FreeSlots =
        math.max(
            0,
            MAX_PLANTS - CurrentPlants
        )


    local ShovelNeeded =
        math.max(
            0,
            TotalSeedCount - FreeSlots
        )


    print("")
    print(
        "========== SHOVEL PHASE =========="
    )

    print(
        "Plot Level:",
        GetPlotLevel(
            GetMyPlot()
        )
    )

    print(
        "Plants:",
        CurrentPlants,
        "/",
        MAX_PLANTS
    )

    print(
        "Seeds:",
        TotalSeedCount
    )

    print(
        "Need Shovel:",
        ShovelNeeded
    )


    if ShovelNeeded <= 0 then

        UnequipTool()

        return

    end


    local Shoveled = 0


    while Shoveled < ShovelNeeded do

        local LowestPlant =
            FindLowestReplaceablePlant(
                ValidSeeds
            )


        if not LowestPlant then

            print(
                "🔨 Tidak ada plant yang bisa diganti."
            )

            break

        end


        local PlantName =
            LowestPlant:GetAttribute(
                "SeedName"
            )


        local BeforeCount =
            CountPlants()


        local Success =
            ShovelPlant(
                LowestPlant
            )


        if not Success then

            warn(
                "❌ Gagal shovel:",
                PlantName
            )

            break

        end


        local Start =
            os.clock()


        while os.clock() - Start < 2 do

            if CountPlants()
                < BeforeCount then

                break

            end


            task.wait(
                0.05
            )

        end


        local AfterCount =
            CountPlants()


        if AfterCount < BeforeCount then

            Shoveled += 1


            print(
                "🔨 Shovel:",
                PlantName,
                "|",
                Shoveled,
                "/",
                ShovelNeeded,
                "|",
                AfterCount,
                "/",
                MAX_PLANTS
            )

        else

            warn(
                "⚠️ Plant tidak berkurang:",
                PlantName
            )

            break

        end


        task.wait(
            ACTION_DELAY
        )

