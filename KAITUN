local function AutoHarvest()

    local Plot =
        GetMyPlot()


    if not Plot then
        return
    end


    local Plants =
        Plot:FindFirstChild(
            "Plants"
        )


    if not Plants then
        return
    end


    for _, Plant in ipairs(
        Plants:GetChildren()
    ) do


        --==================================================
        -- HARVEST PLANT
        --==================================================

        local HarvestPart =
            Plant:FindFirstChild(
                "HarvestPart"
            )


        if HarvestPart then

            local HarvestPrompt =
                HarvestPart:FindFirstChild(
                    "HarvestPrompt"
                )


            if HarvestPrompt
                and HarvestPrompt:IsA(
                    "ProximityPrompt"
                ) then

                pcall(function()

                    fireproximityprompt(
                        HarvestPrompt
                    )

                end)


                task.wait(
                    HARVEST_DELAY
                )

            end

        end


        --==================================================
        -- FRUITS
        --==================================================

        local Fruits =
            Plant:FindFirstChild(
                "Fruits"
            )


        if not Fruits then
            continue
        end


        for _, Fruit in ipairs(
            Fruits:GetChildren()
        ) do


            --==================================================
            -- FRUIT NAME
            --
            -- Prioritas:
            -- CorePartName
            --
            -- Contoh:
            -- Maple Bamboo
            -- Maple Mushroom
            --==================================================

            local FruitName =
                Fruit:GetAttribute(
                    "CorePartName"
                )


            if not FruitName then

                FruitName =
                    Fruit.Name

            end


            --==================================================
            -- BLACKLIST
            --==================================================

            if BLACKLIST[
                FruitName
            ] then

                continue

            end


            --==================================================
            -- SPECIAL FRUIT
            --
            -- Maple Bamboo
            -- Maple Mushroom
            --
            -- WAJIB PUNYA MUTATION
            --==================================================

            if IsMutationRequiredFruit(
                FruitName
            ) then

                local Mutation =
                    Fruit:GetAttribute(
                        "Mutation"
                    )


                -- Belum mutation
                if not Mutation then

                    continue

                end

            end


            --==================================================
            -- HARVEST PART
            --==================================================

            local FruitHarvestPart =
                Fruit:FindFirstChild(
                    "HarvestPart"
                )


            if not FruitHarvestPart then
                continue
            end


            --==================================================
            -- HARVEST PROMPT
            --==================================================

            local FruitPrompt =
                FruitHarvestPart:
                    FindFirstChild(
                        "HarvestPrompt"
                    )


            if not FruitPrompt
                or not FruitPrompt:IsA(
                    "ProximityPrompt"
                ) then

                continue

            end


            --==================================================
            -- HARVEST
            --==================================================

            pcall(function()

                fireproximityprompt(
                    FruitPrompt
                )

            end)


            task.wait(
                HARVEST_DELAY
            )

        end

    end

end


