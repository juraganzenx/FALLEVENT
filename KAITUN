--==================================================
-- GET SEED TOOLS
--==================================================

local function GetSeedTools()

    local Character =
        LocalPlayer.Character

    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )

    local Result = {}


    if not Backpack then
        return Result
    end


    local function Scan(
        Container
    )

        for _, Tool in ipairs(
            Container:GetChildren()
        ) do

            if not Tool:IsA("Tool") then
                continue
            end


            local SeedTool =
                Tool:GetAttribute(
                    "SeedTool"
                )

            if not SeedTool then
                continue
            end


            local SeedName =
                Tool.Name


            local Rarity,
                RarityValue =
                GetRarityFromSeedName(
                    SeedName
                )


            local Count =
                tonumber(
                    Tool:GetAttribute(
                        "Count"
                    )
                ) or 0


            if Count > 0 then

                table.insert(
                    Result,
                    {

                        Tool =
                            Tool,

                        SeedName =
                            SeedName,

                        SeedTool =
                            SeedTool,

                        Count =
                            Count,

                        Rarity =
                            Rarity,

                        RarityValue =
                            RarityValue,

                    }
                )

            end

        end

    end


    Scan(
        Backpack
    )


    if Character then

        Scan(
            Character
        )

    end


    return Result

end


