--==================================================
-- HARVEST ONE FRUIT
--==================================================

local function HarvestFruit(
    Fruit
)

    if not Fruit then
        return false
    end


    --==================================================
    -- GET FRUIT NAME
    --==================================================

    local FruitName =
        Fruit:GetAttribute(
            "CorePartName"
        )


    if not FruitName then

        FruitName =
            Fruit.Name

    end


    --==================================================
    -- BLACKLIST
    --==================================================

    if BLACKLIST[
        FruitName
    ] then

        return false

    end


    --==================================================
    -- SPECIAL MUTATION FRUIT
    --
    -- Maple Bamboo
    -- Maple Mushroom
    --
    -- WAJIB ADA MUTATION
    --==================================================

    if IsMutationRequiredFruit(
        FruitName
    ) then

        local Mutation =
            Fruit:GetAttribute(
                "Mutation"
            )


        if not Mutation then

            return false

        end

    end


    --==================================================
    -- HARVEST PART
    --==================================================

    local HarvestPart =
        Fruit:FindFirstChild(
            "HarvestPart"
        )


    if not HarvestPart then
        return false
    end


    --==================================================
    -- PROMPT
    --==================================================

    local HarvestPrompt =
        HarvestPart:FindFirstChild(
            "HarvestPrompt"
        )


    if not HarvestPrompt
        or not HarvestPrompt:IsA(
            "ProximityPrompt"
        ) then

        return false

    end


    --==================================================
    -- HARVEST
    --==================================================

    pcall(function()

        fireproximityprompt(
            HarvestPrompt
        )

    end)


    task.wait(
        HARVEST_DELAY
    )


    return true

end


