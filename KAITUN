local function GetFrontBedPosition(Plot)

    if not Plot then
        return nil
    end

    local Visual =
        Plot:FindFirstChild(
            "Visual"
        )

    if not Visual then
        return nil
    end


    local ExpandPosition =
        GetExpandPosition(
            Plot
        )

    if not ExpandPosition then
