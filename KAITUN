--==================================================
-- EQUIP SHOVEL
--==================================================

local function EquipShovel()

    local Character =
        LocalPlayer.Character


    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    if not Character
        or not Backpack then

        return nil

    end


    local Shovel =
        GetShovel()


    if Shovel then
        return Shovel
    end


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and Tool:GetAttribute(
                "Shovel"
            ) then

            Tool.Parent =
                Character


            task.wait(0.1)


            return Tool

        end

    end


    return nil

end


--==================================================
-- GET SEED TOOLS
--==================================================

local function GetSeedTools()

    local Character =
        LocalPlayer.Character


    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    local Result = {}


    if not Backpack then
        return Result
    end


    local function Scan(
        Container
    )

        for _, Tool in ipairs(
            Container:GetChildren()
        ) do

            if not Tool:IsA("Tool") then
                continue
            end


            local SeedTool =
                Tool:GetAttribute(
                    "SeedTool"
                )


            if not SeedTool then
                continue
            end


            --==================================================
            -- DISPLAY NAME
            --==================================================

            local SeedName =
                Tool.Name


            local Rarity,
                RarityValue =
                GetRarityFromSeedName(
                    SeedName
                )


            local Count =
                tonumber(
                    Tool:GetAttribute(
                        "Count"
                    )
                ) or 0


            if Count > 0 then

                table.insert(
                    Result,
                    {

                        Tool =
                            Tool,

                        SeedName =
                            SeedName,

                        SeedTool =
                            SeedTool,

                        Count =
                            Count,

                        Rarity =
                            Rarity,

                        RarityValue =
                            RarityValue,

                    }
                )

            end

        end

    end


    Scan(
        Backpack
    )


    if Character then

        Scan(
            Character
        )

    end


    return Result

end


