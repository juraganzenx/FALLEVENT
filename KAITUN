local function PlaceSprinklers()

    local Plot =
        GetMyPlot()

    if not Plot then
        return false
    end


    local PlotId =
        LocalPlayer:GetAttribute(
            "PlotId"
        )

    if not PlotId then
        return false
    end


    local Folder =
        GetSprinklerFolder(
            Plot
        )

    if not Folder then

        warn(
            "[SPRINKLER] Folder tidak ditemukan."
        )

        return false

    end


    local Base =
        GetFrontBedPosition(
            Plot
        )

    if not Base then

        warn(
            "[SPRINKLER] FRONT_BedSection tidak ditemukan."
        )

        return false

    end


    local PlacedAny = false


    for _, Name in ipairs(
        SPRINKLERS
    ) do

        if not HasSprinkler(
            Folder,
            Name
        ) then

            local Tool =
                EquipSprinkler(
                    Name
                )

            if Tool then

                local Success =
                    pcall(function()

                        Networking.Place
                            .PlaceSprinkler
                            :Fire(

                                Base
                                + (
                                    SPRINKLER_OFFSETS[
                                        Name
                                    ]
                                    or Vector3.new(
                                        0,
                                        3,
                                        0
                                    )
                                ),

                                Name,

                                Tool,

                                PlotId

                            )

                    end)


                if Success then

                    PlacedAny = true

                    print(
                        "[SPRINKLER]",
                        Name,
                        "PLACED"
                    )

                    task.wait(
                        0.5
                    )

                end

            else

                print(
                    "[SPRINKLER]",
                    Name,
                    "tidak ditemukan"
                )

            end

        end

    end


    UnequipTool()

    return PlacedAny

end


