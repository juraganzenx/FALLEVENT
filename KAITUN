    end


    local ClosestSection = nil

    local ClosestDistance =
        math.huge


    for _, Obj in ipairs(
        Visual:GetChildren()
    ) do

        if Obj.Name ~=
            "FRONT_BedSection" then

            continue

        end


        local Position


        if Obj:IsA("Model") then

            local Success,
                Pivot =
                pcall(function()

                    return Obj:GetPivot()

                end)

            if Success and Pivot then
                Position =
                    Pivot.Position
            end

        elseif Obj:IsA("BasePart") then

            Position =
                Obj.Position

        end


        if Position then

            local Distance =
                (
                    Position
                    - ExpandPosition
                ).Magnitude


            if Distance <
                ClosestDistance then

                ClosestDistance =
                    Distance

                ClosestSection =
                    Obj

            end

        end

    end


    if not ClosestSection then
