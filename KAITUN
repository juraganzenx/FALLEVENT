--==================================================
-- PLACE SPRINKLERS
--==================================================

local function PlaceSprinklers()

    local Plot =
        GetMyPlot()

    if not Plot then
        return false
    end


    local PlotId =
        LocalPlayer:GetAttribute(
            "PlotId"
        )

    if not PlotId then
        return false
    end


    local Folder =
        Plot:FindFirstChild(
            "Sprinklers"
        )

    if not Folder then
        return false
    end


    local Base =
        GetFrontBedPosition(
            Plot
        )

    if not Base then
        return false
    end


    local Placed = false


    for _, Name in ipairs(
        SPRINKLER_CONFIG.SPRINKLERS
    ) do

        if not HasSprinkler(
            Folder,
            Name
        ) then

            local Tool =
                EquipSprinkler(
                    Name
                )

            if Tool then

                pcall(function()

                    Networking.Place
                        .PlaceSprinkler
                        :Fire(

                            Base
                            + (
                                SPRINKLER_CONFIG
                                .SPRINKLER_OFFSETS[
                                    Name
                                ]
                                or Vector3.new(
                                    0,
                                    3,
                                    0
                                )
                            ),

                            Name,

                            Tool,

                            PlotId

                        )

                end)


                print(
                    "[SPRINKLER]",
                    Name,
                    "PLACED"
                )


                Placed = true

                task.wait(
                    0.5
                )

            end

        end

    end


    UnequipTool()

    return Placed

end


