                .PreviewSellAll
                :Fire()

        end)

    if not Success
        or not Preview then

        return

    end

    local FruitCount =
        tonumber(
            Preview.FruitCount
        ) or 0

    if FruitCount <= 0 then
        return
    end

    pcall(function()

        Networking.NPCS
            .SellAll
            :Fire()

    end)

end


--==================================================
-- SORT SEEDS
--==================================================

local function SortSeeds(Seeds)

    table.sort(
        Seeds,
        function(A, B)

            if A.RarityValue
                == B.RarityValue then

                return A.SeedName
                    < B.SeedName

            end

            return A.RarityValue
                > B.RarityValue

        end
    )

    return Seeds

end


--==================================================
-- FIND LOWEST REPLACEABLE PLANT
--==================================================

local function FindLowestReplaceablePlant(
    ValidSeeds
)

    local LowestPlant = nil

    local LowestRarityValue =
        math.huge


    for _, Plant in ipairs(
        GetPlants()
    ) do

        local PlantSeedName =
            Plant:GetAttribute(
                "SeedName"
            )

        if not PlantSeedName then
            continue
        end


        local PlantRarity,
            PlantRarityValue =
            GetRarityFromSeedName(
                PlantSeedName
            )

        if not PlantRarity then

            warn(
                "⚠️ Unknown SeedName:",
                PlantSeedName
            )

            continue

        end


        local CanReplace = false


        for _, SeedData in ipairs(
            ValidSeeds
        ) do

            --------------------------------------------------
            -- SPECIAL ONLY DURING WEATHER
            --------------------------------------------------

            if SPECIAL_PLANTS[
                SeedData.SeedName
            ] then

                if not IsWeatherActive() then
                    continue
                end

            end


            if SeedData.RarityValue
                > PlantRarityValue then

                CanReplace = true

                break

            end

        end


        if not CanReplace then
            continue
        end


        if PlantRarityValue
            < LowestRarityValue then

            LowestPlant =
                Plant

            LowestRarityValue =
                PlantRarityValue

        end

    end


    return LowestPlant,
        LowestRarityValue

end


