--==================================================
-- GET RARITY
--
-- INPUT:
-- Maple Carrot
--
-- OUTPUT:
-- Common, 1
--==================================================

local function GetRarityFromSeedName(
    Name
)

    if not Name then
        return nil, 0
    end


    Name =
        tostring(Name)


    local Rarity =
        SEED_RARITY[Name]


    if not Rarity then
        return nil, 0
    end


    return Rarity,
        RARITY_ORDER[Rarity] or 0

end


