--==================================================
-- PLANT PHASE
--==================================================

local function PlantPhase()

    print("")
    print(
        "========== PLANT PHASE =========="
    )


    local Seeds =
        GetSeedTools()


    if #Seeds == 0 then

        UnequipTool()

        return

    end


    local ValidSeeds = {}


    for _, SeedData in ipairs(
        Seeds
    ) do

        if SeedData.RarityValue > 0 then

            table.insert(
                ValidSeeds,
                SeedData
            )

        else

            warn(
                "⚠️ Rarity tidak ditemukan:",
                SeedData.SeedName
            )

        end

    end


    if #ValidSeeds == 0 then

        UnequipTool()

        return

    end


    SortSeeds(
        ValidSeeds
    )


    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        for i = 1, 100000 do

            local CurrentCount =
                tonumber(
                    SeedData.Tool:
                        GetAttribute(
                            "Count"
                        )
                ) or 0


            if CurrentCount <= 0 then
                break
            end


            --==================================================
            -- DYNAMIC MAX PLANTS
            --==================================================

            local MAX_PLANTS =
                GetMaxPlants()


            local CurrentPlants =
                CountPlants()


            if CurrentPlants
                >= MAX_PLANTS then

                print(
                    "🌱 Plant penuh:",
                    CurrentPlants,
                    "/",
                    MAX_PLANTS
                )

                break

            end


            local Success =
                PlantSeed(
                    SeedData
                )


            if not Success then

                warn(
                    "❌ Gagal plant:",
                    SeedData.SeedName
                )

                break

            end


            print(
                "🌱 Plant:",
                SeedData.SeedName,
                "|",
                CountPlants(),
                "/",
                GetMaxPlants()
            )


            task.wait(
                ACTION_DELAY
            )

        end

    end


    UnequipTool()

    task.wait(
        0.15
    )


    print(
        "🌱 PLANT PHASE SELESAI"
    )

end


