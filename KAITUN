end


--==================================================
-- RANDOM PLANT POSITION
--==================================================

local function GetNextPlantPosition()

    local BottomFace =
        GetBottomFace()

    if not BottomFace then
        return nil
    end


    while true do

        local Angle =
            math.random()
            * math.pi
            * 2

        local Radius =
            math.sqrt(
                math.random()
            )
            * RADIUS

        local Height =
            math.random()
            * MAX_HEIGHT


        local LocalPos =
            Vector3.new(

                math.cos(Angle)
                    * Radius,

                Height,

                math.sin(Angle)
                    * Radius

            )


        local WorldPos =
            BottomFace.CFrame:
                PointToWorldSpace(
                    LocalPos
                )


        local Valid = true


        for _, Pos in ipairs(
            UsedPositions
        ) do

            if (
                Pos
                - WorldPos
            ).Magnitude
                < MIN_DISTANCE then

                Valid = false

                break

            end

        end


        if Valid then

            table.insert(
                UsedPositions,
                WorldPos
            )

            return WorldPos

        end

    end

end


