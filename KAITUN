--==================================================
-- HARVEST FRUIT
--==================================================

local function HarvestFruit(
    Fruit
)

    if not Fruit then
        return false
    end

    local CorePartName =
        Fruit:GetAttribute(
            "CorePartName"
        )

    if BLACKLIST[
        CorePartName
    ] then

        return false

    end

    local FruitName =
        GetFruitName(
            Fruit
        )


    if MUTATION_REQUIRED_FRUITS[
        FruitName
    ] then

        local Mutation =
            Fruit:GetAttribute(
                "Mutation"
            )

        if not Mutation then
            return false
        end

    end

    return FireHarvestPrompt(
        Fruit
    )

end


--==================================================
-- HARVEST ONE PLANT
--==================================================

local function HarvestPlant(
    Plant
)

    if not Plant then
        return
    end

    local SeedName =
        Plant:GetAttribute(
            "SeedName"
        )


    if ONE_TIME_PLANTS[
        SeedName
    ] then

        HarvestOneTimePlant(
            Plant
        )

        return

    end


    FireHarvestPrompt(
        Plant
    )


    local Fruits =
        Plant:FindFirstChild(
            "Fruits"
        )

    if not Fruits then
        return
    end


    --==================================================
    -- MUTATION FIRST
    --==================================================

    for _, Fruit in ipairs(
        Fruits:GetChildren()
    ) do

        if not Fruit:GetAttribute(
            "Mutation"
        ) then

            continue

        end

        HarvestFruit(
            Fruit
        )

    end


    --==================================================
    -- NORMAL FRUIT
    --==================================================

    for _, Fruit in ipairs(
        Fruits:GetChildren()
    ) do

        if Fruit:GetAttribute(
            "Mutation"
        ) then

            continue

        end

        HarvestFruit(
            Fruit
        )

    end

end


