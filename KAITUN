--==================================================
-- GET STOCK
--==================================================

local function GetStock(
    SeedFrame
)

    local MainFrame =
        SeedFrame:FindFirstChild(
            "Main_Frame"
        )


    if not MainFrame then
        return 0
    end


    local StockText =
        MainFrame:FindFirstChild(
            "Stock_Text"
        )


    if not StockText then
        return 0
    end


    local StockAmount =
        tonumber(
            string.match(
                StockText.Text,
                "x(%d+)"
            )
        )


    return StockAmount or 0

end


