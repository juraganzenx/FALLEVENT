    --------------------------------------------------

    if workspace:FindFirstChild(
        "ActiveBlizzard"
    ) then

        return "Snowfall (Blizzard)"

    end


    --------------------------------------------------
    -- STARFALL
    --------------------------------------------------

    if workspace:GetAttribute(
        "ShootingStarEvent"
