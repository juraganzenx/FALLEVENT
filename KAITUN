--==================================================
-- IS SPECIAL SEED
--==================================================

local function IsSpecialSeed(
    SeedName
)

    return SPECIAL_PLANTS[
        SeedName
    ] == true

end


--==================================================
-- CAN PLANT SEED
--==================================================

local function CanPlantSeed(
    SeedData
)

    if not SeedData then
        return false
    end


    local SeedName =
        SeedData.SeedName


    --------------------------------------------------
    -- NEVER PLANT
    --------------------------------------------------

    if NEVER_PLANT[
        SeedName
    ] then

        return false

    end


    --------------------------------------------------
    -- GET CURRENT LEVEL
    --------------------------------------------------

    local Plot =
        GetMyPlot()

    local Level =
        GetPlotLevel(
            Plot
        )


    --------------------------------------------------
    -- LEVEL 3:
    -- NEVER PLANT COMMON + UNCOMMON
    --------------------------------------------------

    if Level >= 3 then

        local _,
            RarityValue =
            GetRarityFromSeedName(
                SeedName
            )

        if RarityValue == 1
            or RarityValue == 2 then

            return false

        end

    end


    --------------------------------------------------
    -- SPECIAL:
    -- WAJIB ADA WEATHER
    --------------------------------------------------

    if IsSpecialSeed(
        SeedName
    ) then

        if not IsWeatherActive() then

            return false

        end

    end


    return true

end


--==================================================
-- PLANT SEED
--==================================================

local function PlantSeed(
    SeedData
)

    if not CanPlantSeed(
        SeedData
    ) then

        return false

    end


    local Tool =
        SeedData.Tool

    if not Tool then
        return false
    end


    local Character =
        LocalPlayer.Character

    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )

    if not Character
        or not Backpack then

        return false

    end


    local CurrentCount =
        tonumber(
            Tool:GetAttribute(
                "Count"
            )
        ) or 0


    if CurrentCount <= 0 then
        return false
    end


    if Tool.Parent ~= Character
        and Tool.Parent ~= Backpack then

        return false

    end


    if Tool.Parent ~= Character then

        Tool.Parent =
            Character

        task.wait(
            0.1
        )

    end


    local SeedTool =
        Tool:GetAttribute(
            "SeedTool"
        )

    if not SeedTool then
        return false
    end


    local PlantPos =
        GetNextPlantPosition()

    if not PlantPos then
        return false
    end


    local Success =
        pcall(function()

            Networking.Plant
                .PlantSeed
                :Fire(
                    PlantPos,
                    SeedTool,
                    Tool
                )

        end)


    if Success then

        task.wait(
            ACTION_DELAY
        )

        return true

    end

    return false

end


--==================================================
-- SPECIAL PLANT SEQUENCE
--==================================================

local function SpecialPlantSequence(
    SeedData
)

    if not SeedData then
        return false
    end


    local SeedName =
        SeedData.SeedName


    if not IsSpecialSeed(
        SeedName
    ) then

        return false

    end


    --------------------------------------------------
    -- WEATHER WAJIB ADA
    --------------------------------------------------

    local Weather =
        GetActiveWeather()

    if not Weather then

        print(
            "[SPECIAL SKIP]",
            SeedName,
            "| Tidak ada weather."
        )

        return false

    end


    --------------------------------------------------
    -- CHECK SPECIAL LIMIT
    --------------------------------------------------

    local CurrentSpecial =
        CountSpecialPlants(
            SeedName
        )


    local Need =
        math.max(
            0,
            SPECIAL_PLANT_LIMIT
            - CurrentSpecial
        )


    if Need <= 0 then

        print(
            "[SPECIAL MAX]",
            SeedName,
            "|",
            CurrentSpecial,
            "/",
            SPECIAL_PLANT_LIMIT
        )

        return false

    end


    local Count =
        tonumber(
            SeedData.Tool:
                GetAttribute(
                    "Count"
                )
        ) or 0


    if Count <= 0 then
        return false
    end


    print("")
    print(
        "======================================"
    )

    print(
        "[SPECIAL]",
        SeedName
    )

    print(
        "Weather:",
        Weather
    )

    print(
        "Garden:",
        CurrentSpecial,
        "/",
        SPECIAL_PLANT_LIMIT
    )

    print(
        "Backpack:",
        Count
    )

    print(
        "Need:",
        math.min(
            Count,
            Need
        )
    )

    print(
        "Sequence: SPRINKLER -> PLANT -> WATER"
    )

    print(
        "======================================"
    )


    --------------------------------------------------
    -- SPRINKLER
    --------------------------------------------------

    pcall(function()

        PlaceSprinklers()

    end)


    task.wait(
        SPRINKLER_CONFIG
            .AFTER_SPRINKLER_DELAY
    )


    --------------------------------------------------
    -- PLANT SPECIAL
    --------------------------------------------------

    local Planted = 0


    while
        Planted < Need
        and
        Count > 0
        and
        CountSpecialPlants(
            SeedName
        ) < SPECIAL_PLANT_LIMIT
    do

        --------------------------------------------------
        -- WEATHER HARUS MASIH AKTIF
        --------------------------------------------------

        if not IsWeatherActive() then

            print(
                "[SPECIAL STOP]",
                SeedName,
                "| Weather berakhir."
            )

            break

        end


        local MAX_PLANTS =
            GetMaxPlants()


        local CurrentPlants =
            CountPlants()


        if CurrentPlants >=
            MAX_PLANTS then

            print(
                "[SPECIAL] Garden penuh:",
                CurrentPlants,
                "/",
                MAX_PLANTS
            )

            break

        end


        local Success =
            PlantSeed(
                SeedData
            )


        if not Success then

            warn(
                "[SPECIAL] Gagal plant:",
                SeedName
            )

            break

        end


        Planted += 1


        Count =
            tonumber(
                SeedData.Tool:
                    GetAttribute(
                        "Count"
                    )
            ) or 0


        print(
            "[SPECIAL] PLANTED:",
            SeedName,
            "|",
            CountSpecialPlants(
                SeedName
            ),
            "/",
            SPECIAL_PLANT_LIMIT,
            "| Backpack:",
            Count
        )


        task.wait(
            ACTION_DELAY
        )

    end


    --------------------------------------------------
    -- WATER
    --------------------------------------------------

    if Planted > 0 then

        task.wait(
            0.5
        )

        pcall(function()

            UseWateringCan()

        end)

        task.wait(
            SPRINKLER_CONFIG
                .AFTER_WATER_DELAY
        )

    end


    return Planted > 0

end


--==================================================
-- SHOVEL PHASE
--
-- LEVEL 3:
-- SHOVEL ALL COMMON + UNCOMMON
--
-- LEVEL 1/2:
-- ORIGINAL SMART REPLACE SYSTEM
--==================================================

local function ShovelPhase(
    ValidSeeds
)

    local Plot =
        GetMyPlot()

    if not Plot then
        return
    end


    local Level =
        GetPlotLevel(
            Plot
        )


    local CurrentPlants =
        CountPlants()


    local MAX_PLANTS =
        GetMaxPlants()


    --------------------------------------------------
    -- LEVEL 3
    --
    -- SETIAP SMARTPLANT:
    -- SHOVEL SEMUA COMMON + UNCOMMON
    --------------------------------------------------

    if Level >= 3 then

        print("")
        print(
            "========== LEVEL 3 SHOVEL =========="
        )

        print(
            "Level 3 terdeteksi."
        )

        print(
            "Target: SEMUA COMMON + UNCOMMON"
        )

        print(
            "Plants:",
            CurrentPlants,
            "/",
            MAX_PLANTS
        )


        local Shoveled = 0


        --------------------------------------------------
        -- COPY PLANT LIST
        --
        -- Supaya aman saat plant dihapus
        --------------------------------------------------

        local PlantList = {}


        for _, Plant in ipairs(
            GetPlants()
        ) do

            table.insert(
                PlantList,
                Plant
            )

        end


        --------------------------------------------------
        -- SHOVEL COMMON + UNCOMMON
        --------------------------------------------------

        for _, Plant in ipairs(
            PlantList
        ) do

            if not Plant
                or not Plant.Parent then

                continue

            end


            local SeedName =
                Plant:GetAttribute(
                    "SeedName"
                )

            if not SeedName then
                continue
            end


            local Rarity,
                RarityValue =
                GetRarityFromSeedName(
                    SeedName
                )


            --------------------------------------------------
            -- COMMON
            --------------------------------------------------

            if RarityValue ~= 1
                and RarityValue ~= 2 then

                continue

            end


            local BeforeCount =
                CountPlants()


            print(
                "🔨 Level 3 Shovel:",
                SeedName,
                "|",
                Rarity
            )


            local Success =
                ShovelPlant(
                    Plant
                )


            if not Success then

                warn(
                    "❌ Gagal shovel:",
                    SeedName
                )

                continue

            end


            --------------------------------------------------
            -- WAIT PLANT HILANG
            --------------------------------------------------

            local Start =
                os.clock()


            while os.clock()
                - Start < 2 do

                if CountPlants()
                    < BeforeCount then

                    break

                end

                task.wait(
                    0.05
                )

            end


            --------------------------------------------------
            -- VERIFY
            --------------------------------------------------

            local AfterCount =
                CountPlants()


            if AfterCount <
                BeforeCount then

                Shoveled += 1

                print(
                    "✅ Shoveled:",
                    SeedName,
                    "| Total:",
                    Shoveled,
                    "| Plants:",
                    AfterCount,
                    "/",
                    MAX_PLANTS
                )

            else

                warn(
                    "⚠️ Plant tidak berkurang:",
                    SeedName
                )

            end


            task.wait(
                ACTION_DELAY
            )

        end


        UnequipTool()


        task.wait(
            0.15
        )


        print(
            "🔨 LEVEL 3 SHOVEL SELESAI:",
            Shoveled,
            "plant"
        )

        print(
            "===================================="
        )


        return

    end


    --------------------------------------------------
    -- LEVEL 1 / 2
    --
    -- ORIGINAL SYSTEM
    --------------------------------------------------

    local TotalSeedCount = 0


    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        if NEVER_PLANT[
            SeedData.SeedName
        ] then

            continue

        end


        --------------------------------------------------
        -- SPECIAL ONLY WHEN WEATHER
        --------------------------------------------------

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            if not IsWeatherActive() then
                continue
            end

        end


        local Count =
            tonumber(
                SeedData.Tool:
                    GetAttribute(
                        "Count"
                    )
            ) or 0


        --------------------------------------------------
        -- SPECIAL:
        -- ONLY COUNT NEEDED
        --------------------------------------------------

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            local Existing =
                CountSpecialPlants(
                    SeedData.SeedName
                )

            local Need =
                math.max(
                    0,
                    SPECIAL_PLANT_LIMIT
                    - Existing
                )

            Count =
                math.min(
                    Count,
                    Need
                )

        end


        if Count > 0 then
            TotalSeedCount += Count
        end

    end


    if TotalSeedCount <= 0 then

        UnequipTool()

        return

    end


    local FreeSlots =
        math.max(
            0,
            MAX_PLANTS
            - CurrentPlants
        )


    local ShovelNeeded =
        math.max(
            0,
            TotalSeedCount
            - FreeSlots
        )


    print("")
    print(
        "========== SHOVEL PHASE =========="
    )

    print(
        "Plot:",
        Plot.Name
    )

    print(
        "Plot Level:",
        Level
    )

    print(
        "Plants:",
        CurrentPlants,
        "/",
        MAX_PLANTS
    )

    print(
        "Plantable Seeds:",
        TotalSeedCount
    )

    print(
        "Free Slots:",
        FreeSlots
    )

    print(
        "Need Shovel:",
        ShovelNeeded
    )


    if ShovelNeeded <= 0 then

        UnequipTool()

        return

    end


    local Shoveled = 0


    while Shoveled <
        ShovelNeeded do


        --------------------------------------------------
        -- WEATHER
        --------------------------------------------------

        if not IsWeatherActive() then

            local HasSpecial = false


            for _, SeedData in ipairs(
                ValidSeeds
            ) do

                if IsSpecialSeed(
                    SeedData.SeedName
                ) then

                    HasSpecial = true

                    break

                end

            end


            if HasSpecial then

                print(
                    "[SHOVEL] Weather berakhir."
                )

                break

            end

        end


        --------------------------------------------------
        -- FIND LOWEST REPLACEABLE
        --------------------------------------------------

        local LowestPlant =
            FindLowestReplaceablePlant(
                ValidSeeds
            )


        if not LowestPlant then

            print(
                "🔨 Tidak ada plant yang bisa diganti."
            )

            break

        end


        local PlantName =
            LowestPlant:GetAttribute(
                "SeedName"
            )


        local BeforeCount =
            CountPlants()


        local Success =
            ShovelPlant(
                LowestPlant
            )


        if not Success then

            warn(
                "❌ Gagal shovel:",
                PlantName
            )

            break

        end


        local Start =
            os.clock()


        while os.clock()
            - Start < 2 do

            if CountPlants()
                < BeforeCount then

                break

            end

            task.wait(
                0.05
            )

        end


        local AfterCount =
            CountPlants()


        if AfterCount <
            BeforeCount then

            Shoveled += 1

            print(
                "🔨 Shovel:",
                PlantName,
                "|",
                Shoveled,
                "/",
                ShovelNeeded,
                "|",
                AfterCount,
                "/",
                MAX_PLANTS
            )

        else

            warn(
                "⚠️ Plant tidak berkurang:",
                PlantName
            )

            break

        end


        task.wait(
            ACTION_DELAY
        )

    end


    UnequipTool()


    task.wait(
        0.15
    )


    print(
        "🔨 SHOVEL PHASE SELESAI"
    )

end


--==================================================
-- PLANT PHASE
--==================================================

local function PlantPhase()

    print("")
    print(
        "========== PLANT PHASE =========="
    )


    local Seeds =
        GetSeedTools()


    if #Seeds == 0 then

        UnequipTool()

        return

    end


    local Plot =
        GetMyPlot()

    local Level =
        GetPlotLevel(
            Plot
        )


    local ValidSeeds = {}


    for _, SeedData in ipairs(
        Seeds
    ) do

        if SeedData.RarityValue <= 0 then
            continue
        end


        if NEVER_PLANT[
            SeedData.SeedName
        ] then

            continue

        end


        --------------------------------------------------
        -- LEVEL 3:
        -- DON'T PLANT COMMON + UNCOMMON
        --------------------------------------------------

        if Level >= 3 then

            if SeedData.RarityValue == 1
                or SeedData.RarityValue == 2 then

                continue

            end

        end


        --------------------------------------------------
        -- SPECIAL:
        -- ONLY WEATHER
        --------------------------------------------------

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            if IsWeatherActive() then

                table.insert(
                    ValidSeeds,
                    SeedData
                )

            end

        else

            table.insert(
                ValidSeeds,
                SeedData
            )

        end

    end


    if #ValidSeeds == 0 then

        UnequipTool()

        return

    end


    SortSeeds(
        ValidSeeds
    )


    UsedPositions = {}


    --------------------------------------------------
    -- SPECIAL SEEDS FIRST
    --------------------------------------------------

    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            --------------------------------------------------
            -- CHECK WEATHER
            --------------------------------------------------

            if not IsWeatherActive() then

                print(
                    "[SPECIAL] Tidak ada weather, skip:",
                    SeedData.SeedName
                )

                continue

            end


            local Existing =
                CountSpecialPlants(
                    SeedData.SeedName
                )


            local Need =
                math.max(
                    0,
                    SPECIAL_PLANT_LIMIT
                    - Existing
                )


            if Need > 0 then

                SpecialPlantSequence(
                    SeedData
                )

            else

                print(
                    "[SPECIAL MAX]",
                    SeedData.SeedName,
                    Existing,
                    "/",
                    SPECIAL_PLANT_LIMIT
                )

            end

        end

    end


    --------------------------------------------------
    -- NORMAL SEEDS
    --------------------------------------------------

    for _, SeedData in ipairs(
        ValidSeeds
    ) do

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            continue

        end


        while true do

            --------------------------------------------------
            -- LEVEL 3 SAFETY CHECK
            --
            -- Prevent Common/Uncommon from being planted
            -- even if level changes while loop berjalan.
            --------------------------------------------------

            local CurrentPlot =
                GetMyPlot()

            local CurrentLevel =
                GetPlotLevel(
                    CurrentPlot
                )


            if CurrentLevel >= 3 then

                if SeedData.RarityValue == 1
                    or SeedData.RarityValue == 2 then

                    break

                end

            end


            local CurrentCount =
                tonumber(
                    SeedData.Tool:
                        GetAttribute(
                            "Count"
                        )
                ) or 0


            if CurrentCount <= 0 then
                break
            end


            local MAX_PLANTS =
                GetMaxPlants()


            local CurrentPlants =
                CountPlants()


            if CurrentPlants >=
                MAX_PLANTS then

                print(
                    "🌱 Plant penuh:",
                    CurrentPlants,
                    "/",
                    MAX_PLANTS
                )

                break

            end


            local Success =
                PlantSeed(
                    SeedData
                )


            if not Success then

                warn(
                    "❌ Gagal plant:",
                    SeedData.SeedName
                )

                break

            end


            print(
                "🌱 Plant:",
                SeedData.SeedName,
                "|",
                CountPlants(),
                "/",
                GetMaxPlants()
            )


            task.wait(
                ACTION_DELAY
            )

        end

    end


    UnequipTool()


    task.wait(
        0.15
    )


    print(
        "🌱 PLANT PHASE SELESAI"
    )

end


--==================================================
-- SMART PLANT
--==================================================

local function SmartPlant()

    local Seeds =
        GetSeedTools()


    if #Seeds == 0 then
        return
    end


    local Plot =
        GetMyPlot()

    local Level =
        GetPlotLevel(
            Plot
        )


    local ValidSeeds = {}


    for _, SeedData in ipairs(
        Seeds
    ) do

        if SeedData.RarityValue <= 0 then
            continue
        end


        if NEVER_PLANT[
            SeedData.SeedName
        ] then

            continue

        end


        --------------------------------------------------
        -- LEVEL 3:
        -- COMMON + UNCOMMON TIDAK MASUK VALID SEEDS
        --------------------------------------------------

        if Level >= 3 then

            if SeedData.RarityValue == 1
                or SeedData.RarityValue == 2 then

                continue

            end

        end


        --------------------------------------------------
        -- SPECIAL:
        -- ONLY INCLUDE IF WEATHER ACTIVE
        --------------------------------------------------

        if IsSpecialSeed(
            SeedData.SeedName
        ) then

            if IsWeatherActive() then

                table.insert(
                    ValidSeeds,
                    SeedData
                )

            end

        else

            table.insert(
                ValidSeeds,
                SeedData
            )

        end

    end


    --------------------------------------------------
    -- LEVEL 3:
    -- SHOVEL COMMON + UNCOMMON
    --
    -- Walaupun Common/Uncommon tidak ada di
    -- ValidSeeds, ShovelPhase Level 3 memang
    -- khusus mencari tanaman berdasarkan rarity.
    --------------------------------------------------

    if Level >= 3 then

        ShovelPhase(
            ValidSeeds
        )

    else

        --------------------------------------------------
        -- LEVEL 1 / 2:
        -- ORIGINAL SHOVEL SYSTEM
        --------------------------------------------------

        if #ValidSeeds > 0 then

            SortSeeds(
                ValidSeeds
            )

            ShovelPhase(
                ValidSeeds
            )

        end

    end


    task.wait(
        0.15
    )


    --------------------------------------------------
    -- PLANT
    --------------------------------------------------

    PlantPhase()

end


