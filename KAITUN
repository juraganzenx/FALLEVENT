--==================================================
-- HARVEST PLANT
--==================================================

local function HarvestPlant(Plant)

    if not Plant then
        return
    end

    local SeedName =
        Plant:GetAttribute(
            "SeedName"
        )


    --------------------------------------------------
    -- SPECIAL PLANT
    --------------------------------------------------

    if SPECIAL_PLANTS[
        SeedName
    ] then

        HarvestSpecialPlant(
            Plant
        )

        return

    end


    --------------------------------------------------
    -- HARVEST PLANT PROMPT
    --------------------------------------------------

    FireHarvestPrompt(
        Plant
    )


    local Fruits =
        Plant:FindFirstChild(
            "Fruits"
        )

    if not Fruits then
        return
    end


    local FruitList = {}


    for _, Fruit in ipairs(
        Fruits:GetChildren()
    ) do

        table.insert(
            FruitList,
            Fruit
        )

    end


    --------------------------------------------------
    -- RARITY TERTINGGI -> TERENDAH
    --------------------------------------------------

    table.sort(
        FruitList,
        function(A, B)

            local ARarity =
                GetFruitRarityValue(
                    A
                )

            local BRarity =
                GetFruitRarityValue(
                    B
                )


            if ARarity ==
                BRarity then

                local AMutation =
                    A:GetAttribute(
                        "Mutation"
                    )

                local BMutation =
                    B:GetAttribute(
                        "Mutation"
                    )


                if AMutation
                    and not BMutation then

                    return true

                end


                if BMutation
                    and not AMutation then

                    return false

                end


                return A.Name <
                    B.Name

            end


            return ARarity >
                BRarity

        end
    )


    --------------------------------------------------
    -- HARVEST SESUAI RARITY
    --------------------------------------------------

    for _, Fruit in ipairs(
        FruitList
    ) do

        HarvestFruit(
            Fruit
        )

    end

end


