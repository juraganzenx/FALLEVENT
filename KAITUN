        end

        local CanReplace = false

        for _, SeedData in ipairs(
            ValidSeeds
        ) do

            if SeedData.RarityValue
                > PlantRarityValue then

                CanReplace = true

                break

            end

        end

        if not CanReplace then
            continue
        end

        if PlantRarityValue
            < LowestRarityValue then

            LowestPlant =
                Plant

            LowestRarityValue =
                PlantRarityValue

        end

    end

    return LowestPlant,
        LowestRarityValue

end


