--==================================================
-- GET EXPAND POSITION
--==================================================

local function GetExpandPosition(
    Plot
)

    if not Plot then
        return nil
    end

    local Signs =
        Plot:FindFirstChild(
            "Signs"
        )

    if not Signs then
        return nil
    end

    local Expand =
        Signs:FindFirstChild(
            "Expand"
        )

    if not Expand then
        return nil
    end


    if Expand:IsA("Model") then

        local Success,
            Pivot =
            pcall(function()

                return Expand:GetPivot()

            end)

        if Success and Pivot then

            return Pivot.Position

        end

    end


    if Expand:IsA("BasePart") then

        return Expand.Position

    end


    local PrimaryPart =
        Expand:IsA("Model")
        and Expand.PrimaryPart

    if PrimaryPart then

        return PrimaryPart.Position

    end

    return nil

end


--==================================================
-- GET FRONT BED SECTION PALING DEKAT EXPAND
--==================================================

local function GetPlantBedSection()

    local Plot =
        GetMyPlot()

    if not Plot then
        return nil
    end

    local Visual =
        Plot:FindFirstChild(
            "Visual"
        )

    if not Visual then
        return nil
    end


    local ExpandPosition =
        GetExpandPosition(
            Plot
        )

    if not ExpandPosition then

        warn(
            "[AUTO PLANT] Signs.Expand tidak ditemukan."
        )

        return nil

    end


    local FrontSections = {}

    for _, Obj in ipairs(
        Visual:GetChildren()
    ) do

        if Obj.Name ==
            "FRONT_BedSection" then

            table.insert(
                FrontSections,
                Obj
            )

        end

    end


    if #FrontSections == 0 then

        warn(
            "[AUTO PLANT] FRONT_BedSection tidak ditemukan."
        )

        return nil

    end


    local ClosestSection = nil

    local ClosestDistance =
        math.huge


    for _, Section in ipairs(
        FrontSections
    ) do

        local SectionPosition


        if Section:IsA("Model") then

            local Success,
                Pivot =
                pcall(function()

                    return Section:GetPivot()

                end)

            if Success and Pivot then

                SectionPosition =
                    Pivot.Position

            end

        elseif Section:IsA("BasePart") then

            SectionPosition =
                Section.Position

        end


        if SectionPosition then

            local Distance =
                (
                    SectionPosition
                    - ExpandPosition
                ).Magnitude


            if Distance <
                ClosestDistance then

                ClosestDistance =
                    Distance

                ClosestSection =
                    Section

            end

        end

    end


    if ClosestSection then

        print(
            "[AUTO PLANT] FRONT_BedSection:",
            ClosestSection:GetFullName()
        )

        print(
            "[AUTO PLANT] Distance Expand:",
            ClosestDistance
        )

    end


    return ClosestSection

end


