--==================================================
-- EQUIP SPRINKLER
--==================================================

local function EquipSprinkler(Name)

    local Character =
        LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    local Backpack =
        LocalPlayer:WaitForChild(
            "Backpack"
        )


    for _, Tool in ipairs(
        Character:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and Tool:GetAttribute(
                "Sprinkler"
            ) == Name then

            return Tool

        end

    end


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if Tool:IsA("Tool")
            and Tool:GetAttribute(
                "Sprinkler"
            ) == Name then

            local Humanoid =
                Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Humanoid then

                Humanoid:EquipTool(
                    Tool
                )

                task.wait(
                    0.35
                )

            end

            return Tool

        end

    end

    return nil

end


