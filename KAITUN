--==================================================
-- SORT SEEDS
--==================================================

local function SortSeeds(
    Seeds
)

    table.sort(
        Seeds,
        function(A, B)

            if A.RarityValue
                == B.RarityValue then

                return A.SeedName
                    < B.SeedName

            end

            return A.RarityValue
                > B.RarityValue

        end
    )

    return Seeds

end


