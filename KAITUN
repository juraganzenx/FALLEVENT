--==================================================
-- AUTO EXPAND
--==================================================

local function TryExpand()

    local Plot =
        GetMyPlot()


    if not Plot then

        warn(
            "[AUTO EXPAND] Plot tidak ditemukan"
        )

        return

    end


    local Level =
        GetPlotLevel(
            Plot
        )


    if Level == 0 then

        warn(
            "[AUTO EXPAND] Level plot tidak dikenali"
        )

        return

    end


    local Leaves =
        GetLeaves()


    if Leaves == nil then

        warn(
            "[AUTO EXPAND] leaderstats.Leaves tidak ditemukan"
        )

        return

    end


    local CurrentMaxPlants =
        PLANT_LIMIT_BY_LEVEL[
            Level
        ] or 200


    print("")
    print(
        "========== AUTO EXPAND =========="
    )

    print(
        "Plot       :",
        Plot.Name
    )

    print(
        "Level      :",
        Level
    )

    print(
        "Leaves     :",
        FormatNumber(
            Leaves
        )
    )

    print(
        "Max Plants :",
        CurrentMaxPlants
    )


    --==================================================
    -- MAX LEVEL
    --==================================================

    if Level >= MAX_LEVEL then

        print(
            "[AUTO EXPAND] MAX LEVEL:",
            MAX_LEVEL
        )

        print(
            "================================"
        )

        return

    end


    --==================================================
    -- NEXT LEVEL
    --==================================================

    local NextLevel =
        Level + 1


    local RequiredLeaves =
        LEVEL_REQUIREMENT[
            NextLevel
        ]


    if not RequiredLeaves then

        warn(
            "[AUTO EXPAND] Requirement Level",
            NextLevel,
            "tidak ditemukan"
        )

        return

    end


    print(
        "Next Level :",
        NextLevel
    )

    print(
        "Required   :",
        FormatNumber(
            RequiredLeaves
        )
    )


    --==================================================
    -- LEAVES CHECK
    --==================================================

    if Leaves < RequiredLeaves then

        print(
            "[AUTO EXPAND] Leaves belum cukup."
        )

        print(
            "[AUTO EXPAND] Kurang:",
            FormatNumber(
                RequiredLeaves - Leaves
            )
        )

        print(
            "================================"
        )

        return

    end


    --==================================================
    -- EXPAND
    --==================================================

    print(
        "[AUTO EXPAND] Requirement terpenuhi!"
    )

    print(
        "[AUTO EXPAND] Expand:",
        Level,
        "->",
        NextLevel
    )


    local Success,
        Result =
        pcall(function()

            return Networking.Actions
                .ExpandGarden
                :Fire()

        end)


    if Success then

        print(
            "[AUTO EXPAND] Expand request berhasil dikirim."
        )

        task.wait(
            1
        )


        --==================================================
        -- CEK LEVEL BARU
        --==================================================

        local NewPlot =
            GetMyPlot()


        local NewLevel =
            GetPlotLevel(
                NewPlot
            )


        local NewMaxPlants =
            PLANT_LIMIT_BY_LEVEL[
                NewLevel
            ] or CurrentMaxPlants


        print(
            "[AUTO EXPAND] Level sekarang:",
            NewLevel
        )

        print(
            "[AUTO EXPAND] Max Plants sekarang:",
            NewMaxPlants
        )

    else

        warn(
            "[AUTO EXPAND] Error:",
            Result
        )

    end


    print(
        "================================"
    )

end


