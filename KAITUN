--==================================================
-- GET FRONT BED POSITION
--==================================================
-- MENGGUNAKAN FRONT_BedSection
-- TERDEKAT DENGAN Signs.Expand
--==================================================

local function GetFrontBedPosition(
    Plot
)

    if not Plot then
        return nil
    end


    local Visual =
        Plot:FindFirstChild(
            "Visual"
        )

    if not Visual then
        return nil
    end


    local ExpandPosition =
        GetExpandPosition(
            Plot
        )

    if not ExpandPosition then
        return nil
    end


    local ClosestSection = nil

    local ClosestDistance =
        math.huge


    for _, Obj in ipairs(
        Visual:GetChildren()
    ) do

        if Obj.Name ==
            "FRONT_BedSection" then

            local Position


            if Obj:IsA("Model") then

                local Success,
                    Pivot =
                    pcall(function()

                        return Obj:GetPivot()

                    end)

                if Success and Pivot then

                    Position =
                        Pivot.Position

                end

            elseif Obj:IsA("BasePart") then

                Position =
                    Obj.Position

            end


            if Position then

                local Distance =
                    (
                        Position
                        - ExpandPosition
                    ).Magnitude


                if Distance <
                    ClosestDistance then

                    ClosestDistance =
                        Distance

                    ClosestSection =
                        Obj

                end

            end

        end

    end


    if not ClosestSection then
        return nil
    end


    local BottomFace =
        ClosestSection:FindFirstChild(
            "BottomFace"
        )

    if not BottomFace then
        return nil
    end


    if BottomFace:IsA("BasePart") then

        return BottomFace.Position

    end


    if BottomFace:IsA("Attachment") then

        return BottomFace.WorldPosition

    end


    return nil

end


