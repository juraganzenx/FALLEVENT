--==================================================
-- COLLECT SEED V4
-- COLLECT ALL
-- NEAREST SEED FIRST
-- AUTO CHILDADDED
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local Map = workspace:WaitForChild("Map")
local DropFolder = Map:WaitForChild("SeedPackSpawnServerLocations")

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local SPEED = 30
local CHECK_DELAY = 2

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local Busy = false
local Processing = {}

--------------------------------------------------
-- GET ROOT
--------------------------------------------------

local function GetRoot()
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return Character:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- GET NEAREST SEED
--------------------------------------------------

local function GetNearestSeed()
    local Root = GetRoot()

    if not Root then
        return nil
    end

    local Nearest = nil
    local NearestDistance = math.huge

    for _, Part in ipairs(DropFolder:GetChildren()) do

        if Part:IsA("BasePart")
        and Part.Parent
        and not Processing[Part] then

            local Distance =
                (Root.Position - Part.Position).Magnitude

            if Distance < NearestDistance then
                NearestDistance = Distance
                Nearest = Part
            end
        end
    end

    return Nearest
end

--------------------------------------------------
-- TWEEN
--------------------------------------------------

local function TweenTo(cf)
    local Root = GetRoot()

    if not Root then
        return false
    end

    local Distance =
        (Root.Position - cf.Position).Magnitude

    if Distance <= 3 then
        Root.CFrame = cf
        return true
    end

    local Time = Distance / SPEED

    local Tween = TweenService:Create(
        Root,
        TweenInfo.new(
            Time,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = cf
        }
    )

    Tween:Play()
    Tween.Completed:Wait()

    return true
end

--------------------------------------------------
-- COLLECT SEED
--------------------------------------------------

local function CollectSeed(Part)

    if not Part or not Part.Parent then
        return
    end

    Processing[Part] = true

    --------------------------------------------------
    -- TWEEN TO SEED
    --------------------------------------------------

    pcall(function()
        TweenTo(
            Part.CFrame + Vector3.new(0, 3, 0)
        )
    end)

    --------------------------------------------------
    -- GET PROMPT
    --------------------------------------------------

    local Prompt = Part:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if Prompt then

        while Part.Parent and Prompt.Parent do

            pcall(function()
                fireproximityprompt(Prompt)
            end)

            task.wait(0.05)
        end
    end

    Processing[Part] = nil
end

--------------------------------------------------
-- COLLECT LOOP
--------------------------------------------------

local function CollectLoop()

    if Busy then
        return
    end

    Busy = true

    while true do

        --------------------------------------------------
        -- CARI YANG PALING DEKAT
        --------------------------------------------------

        local Part = GetNearestSeed()

        if not Part then
            break
        end

        --------------------------------------------------
        -- COLLECT
        --------------------------------------------------

        CollectSeed(Part)

        task.wait()
    end

    Busy = false
end

--------------------------------------------------
-- CHILD ADDED
--------------------------------------------------

DropFolder.ChildAdded:Connect(function(Part)

    task.wait()

    if Part and Part:IsA("BasePart") then
        task.spawn(CollectLoop)
    end
end)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

task.spawn(function()

    while true do

        CollectLoop()

        task.wait(CHECK_DELAY)

    end

end)
