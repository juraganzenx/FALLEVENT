--V3
local Players = game:GetService("Players")

local Gardens = workspace:WaitForChild("Gardens")
local Baseplate = workspace:WaitForChild("Baseplate")
local Map = workspace:WaitForChild("Map")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local OWNER_WAIT_TIME = 5
local CHECK_INTERVAL = 1

--==================================================
-- DESTROY DECOR & MIDDLE
--==================================================

local Decor = Baseplate:FindFirstChild("Decor")

if Decor then
    Decor:Destroy()
end

local Middle = Map:FindFirstChild("Middle")

if Middle then
    Middle:Destroy()
end

--==================================================
-- DESTROY RAIN EFFECT
--==================================================

local RainObjects = {
    RainDrops = true,
    StromRainDrops = true,
    RainSplashes = true,
    StromSplashes = true,
}

local function DestroyRainObject(Obj)
    if RainObjects[Obj.Name] then
        Obj:Destroy()
    end
end

for _, Obj in ipairs(workspace:GetChildren()) do
    DestroyRainObject(Obj)
end

workspace.ChildAdded:Connect(function(Obj)
    DestroyRainObject(Obj)
end)

--==================================================
-- DESTROY OTHER PLAYER OBJECTS
--==================================================

local function DestroyOtherPlayer(Player)

    if not Player then
        return
    end

    if Player == LocalPlayer then
        return
    end

    if Player.Parent == Players then
        print("🗑️ Destroy Player:", Player.Name)
        Player:Destroy()
    end

end

-- Player yang sudah ada
for _, Player in ipairs(Players:GetPlayers()) do
    DestroyOtherPlayer(Player)
end

-- Player baru
Players.PlayerAdded:Connect(function(Player)

    if Player == LocalPlayer then
        return
    end

    task.defer(function()
        DestroyOtherPlayer(Player)
    end)

end)

--==================================================
-- PROTECTED PARTS
--==================================================

local ProtectedParts = {
    Base = true,
    HarvestPart = true,
    Stud_Part = true,
}

--==================================================
-- GET PLOT OWNER
--==================================================

local function GetPlotOwner(Plot)

    if not Plot then
        return nil
    end

    return Plot:GetAttribute("Owner")

end

--==================================================
-- CHECK MY PLOT
--==================================================

local function IsMyPlot(Plot)

    return GetPlotOwner(Plot) == LocalPlayer.Name

end

--==================================================
-- DESTROY VISUAL
--==================================================

local VisualConnections = {}

local function DestroyVisualObjects(Visual)

    if not Visual or not Visual.Parent then
        return
    end

    for _, Obj in ipairs(Visual:GetDescendants()) do

        if Obj.Name == "FenceConnectors"
        or Obj.Name == "FencePole" then

            Obj:Destroy()

        end

    end

end

--==================================================
-- SETUP VISUAL
--==================================================

local function SetupVisual(Plot, Visual)

    if not Visual or not Visual.Parent then
        return
    end

    DestroyVisualObjects(Visual)

    if VisualConnections[Visual] then
        return
    end

    VisualConnections[Visual] =
        Visual.DescendantAdded:Connect(function(Obj)

            if not Obj or not Obj.Parent then
                return
            end

            if Obj.Name == "FenceConnectors"
            or Obj.Name == "FencePole" then

                Obj:Destroy()

            end

        end)

end

--==================================================
-- DESTROY LOADING CAMERA
--==================================================

local function DestroyLoadingCams(Plot)

    if not Plot or not Plot.Parent then
        return
    end

    local LoadingCam =
        Plot:FindFirstChild("LoadingCam")

    if LoadingCam then
        LoadingCam:Destroy()
    end

    local LoadingScreenCam =
        Plot:FindFirstChild("LoadingScreenCam")

    if LoadingScreenCam then
        LoadingScreenCam:Destroy()
    end

end

--==================================================
-- CHECK PLANT PART
--==================================================

local function CheckPart(Obj)

    if not Obj or not Obj.Parent then
        return
    end

    if not Obj:IsA("BasePart") then
        return
    end

    if ProtectedParts[Obj.Name] then
        return
    end

    Obj:Destroy()

end

--==================================================
-- SETUP PLANTS
--==================================================

local PlantsConnections = {}

local function SetupPlants(Plot, Plants)

    if not Plot
    or not Plot.Parent
    or not Plants
    or not Plants.Parent then
        return
    end

    if not IsMyPlot(Plot) then
        return
    end

    -- Hapus yang sudah ada
    for _, Obj in ipairs(Plants:GetDescendants()) do
        CheckPart(Obj)
    end

    if PlantsConnections[Plants] then
        return
    end

    PlantsConnections[Plants] =
        Plants.DescendantAdded:Connect(function(Obj)

            if not Plants.Parent then
                return
            end

            CheckPart(Obj)

        end)

end

--==================================================
-- SETUP MY PLOT
--==================================================

local PlotConnections = {}

local function SetupMyPlot(Plot)

    if not Plot
    or not Plot.Parent
    or not Plot:IsA("Model") then
        return
    end

    if not IsMyPlot(Plot) then
        return
    end

    print("================================")
    print("✅ PLOT KITA:", Plot.Name)
    print("Owner:", Plot:GetAttribute("Owner"))
    print("================================")

    -- Loading Camera
    DestroyLoadingCams(Plot)

    -- Plants
    local Plants = Plot:FindFirstChild("Plants")

    if Plants then
        SetupPlants(Plot, Plants)
    end

    -- Visual
    local Visual = Plot:FindFirstChild("Visual")

    if Visual then
        SetupVisual(Plot, Visual)
    end

    -- ChildAdded hanya sekali
    if PlotConnections[Plot] then
        return
    end

    PlotConnections[Plot] =
        Plot.ChildAdded:Connect(function(Obj)

            if not Obj or not Obj.Parent then
                return
            end

            --==================================================
            -- LOADING CAMERA
            --==================================================

            if Obj.Name == "LoadingCam"
            or Obj.Name == "LoadingScreenCam" then

                Obj:Destroy()
                return

            end

            --==================================================
            -- PLANTS
            --==================================================

            if Obj.Name == "Plants" then

                task.defer(function()

                    if Plot.Parent
                    and Obj.Parent
                    and IsMyPlot(Plot) then

                        SetupPlants(Plot, Obj)

                    end

                end)

                return
            end

            --==================================================
            -- VISUAL
            --==================================================

            if Obj.Name == "Visual" then

                task.defer(function()

                    if Plot.Parent
                    and Obj.Parent
                    and IsMyPlot(Plot) then

                        SetupVisual(Plot, Obj)

                    end

                end)

                return
            end

        end)

end

--==================================================
-- DESTROY OTHER PLOT
--==================================================

local function DestroyOtherPlot(Plot)

    if not Plot
    or not Plot.Parent
    or not Plot:IsA("Model") then
        return
    end

    local Owner = GetPlotOwner(Plot)

    if not Owner then
        return
    end

    if Owner == LocalPlayer.Name then
        return
    end

    print("🗑️ DESTROY PLOT ORANG")
    print("Plot:", Plot.Name)
    print("Owner:", Owner)

    Plot:Destroy()

end

--==================================================
-- OWNER CONNECTION
--==================================================

local OwnerConnections = {}

local function SetupOwnerListener(Plot)

    if OwnerConnections[Plot] then
        return
    end

    OwnerConnections[Plot] =
        Plot:GetAttributeChangedSignal("Owner"):Connect(function()

            if not Plot.Parent then
                return
            end

            local Owner = GetPlotOwner(Plot)

            print(
                "🔄 OWNER BERUBAH:",
                Plot.Name,
                "=>",
                tostring(Owner)
            )

            if not Owner then
                return
            end

            if Owner == LocalPlayer.Name then

                SetupMyPlot(Plot)

            else

                DestroyOtherPlot(Plot)

            end

        end)

end

--==================================================
-- PROCESS PLOT
--==================================================

local function ProcessPlot(Plot)

    if not Plot
    or not Plot.Parent
    or not Plot:IsA("Model") then
        return
    end

    SetupOwnerListener(Plot)

    local Owner = GetPlotOwner(Plot)

    --==================================================
    -- OWNER BELUM ADA
    --==================================================

    if Owner == nil then

        print("⏳ Menunggu Owner:", Plot.Name)

        task.spawn(function()

            local StartTime = os.clock()

            while Plot.Parent
            and GetPlotOwner(Plot) == nil
            and os.clock() - StartTime < OWNER_WAIT_TIME do

                task.wait(0.1)

            end

            if not Plot.Parent then
                return
            end

            local NewOwner = GetPlotOwner(Plot)

            if not NewOwner then
                print("⚠️ Owner masih nil:", Plot.Name)
                return
            end

            if NewOwner == LocalPlayer.Name then

                SetupMyPlot(Plot)

            else

                DestroyOtherPlot(Plot)

            end

        end)

        return
    end

    --==================================================
    -- PLOT KITA
    --==================================================

    if Owner == LocalPlayer.Name then

        SetupMyPlot(Plot)

    --==================================================
    -- PLOT ORANG
    --==================================================

    else

        DestroyOtherPlot(Plot)

    end

end

--==================================================
-- PROCESS EXISTING PLOTS
--==================================================

for _, Plot in ipairs(Gardens:GetChildren()) do

    if Plot:IsA("Model") then
        ProcessPlot(Plot)
    end

end

--==================================================
-- NEW PLOT
--==================================================

Gardens.ChildAdded:Connect(function(Plot)

    if not Plot:IsA("Model") then
        return
    end

    print("🆕 PLOT BARU:", Plot.Name)

    task.defer(function()

        if Plot.Parent then
            ProcessPlot(Plot)
        end

    end)

end)

--==================================================
-- CONTINUOUS CLEANER
--==================================================

task.spawn(function()

    while true do

        --==================================================
        -- CLEAN OTHER PLAYERS
        --==================================================

        for _, Player in ipairs(Players:GetPlayers()) do

            if Player ~= LocalPlayer then
                DestroyOtherPlayer(Player)
            end

        end

        --==================================================
        -- CLEAN PLOTS
        --==================================================

        for _, Plot in ipairs(Gardens:GetChildren()) do

            if Plot:IsA("Model") and Plot.Parent then

                local Owner = GetPlotOwner(Plot)

                --==================================================
                -- OWNER DIKENAL
                --==================================================

                if Owner then

                    -- Plot orang
                    if Owner ~= LocalPlayer.Name then

                        DestroyOtherPlot(Plot)

                    -- Plot kita
                    else

                        -- Loading Camera
                        DestroyLoadingCams(Plot)

                        -- Visual
                        local Visual =
                            Plot:FindFirstChild("Visual")

                        if Visual then
                            DestroyVisualObjects(Visual)
                            SetupVisual(Plot, Visual)
                        end

                        -- Plants
                        local Plants =
                            Plot:FindFirstChild("Plants")

                        if Plants then

                            for _, Obj in ipairs(
                                Plants:GetDescendants()
                            ) do

                                CheckPart(Obj)

                            end

                            SetupPlants(
                                Plot,
                                Plants
                            )

                        end

                    end

                end

            end

        end

        task.wait(CHECK_INTERVAL)

    end

end)

print("================================")
print("✅ CLEANER AKTIF")
print("Player:", LocalPlayer.Name)
print("Plot Cleaner: ON")
print("Player Cleaner: ON")
print("================================")
